# ─────────────────────────────────────────────────────────
# Artal Sentinel — متغيرات البيئة
# انسخ هذا الملف إلى .env على السيرفر وعدّل القيم
# ─────────────────────────────────────────────────────────

# المنفذ (اختياري — الافتراضي 3000)
PORT=3000

# ─── إعدادات MySQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=u376291233_apply
DB_PASS=YOUR_MYSQL_PASSWORD_HERE
DB_NAME=u376291233_apply

# مسار ملفات الرفع — استخدم مساراً داخل home مستخدمك
# مثال Hostinger: /home/u376291233/uploads
# إذا تركته فارغاً يُحفظ داخل مجلد المشروع (uploads/)
UPLOADS_PATH=/home/u376291233/uploads

# مفتاح تشفير الجلسات — يجب أن يكون عشوائياً طويلاً (لا تستخدم القيمة الافتراضية!)
# لتوليد مفتاح: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-secret-string

# فعّل الـ Secure Cookie — فقط على السيرفر (HTTPS). لا تضعه في بيئة التطوير المحلية
SECURE_COOKIE=true

# مفتاح API النظام الخارجي (artalsys.com)
EXT_API_SECRET=artal@NID%2026

# ─── تكامل Google Meet (المقابلات الأونلاين) ─────────────────
# اختيارية بالكامل: إن تُركت فارغة تبقى ميزة المقابلات معطّلة
# ولا يتأثر أي جزء آخر من النظام (التقديم، المتقدمون، التقارير).
#
# من Google Cloud Console: فعّل Calendar API ← شاشة موافقة Internal
# ← OAuth client من نوع Web application، وأضف رابطي العودة:
#   https://jobs.artalsecurity.com/admin/google/callback
#   http://localhost:3000/admin/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# يجب أن يطابق أحد رابطي العودة أعلاه تماماً (بلا شرطة مائلة زائدة)
GOOGLE_REDIRECT_URI=https://jobs.artalsecurity.com/admin/google/callback

# مفتاح تشفير رمز Google المخزَّن في قاعدة البيانات — 64 حرفاً hex
# لتوليد مفتاح: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ تغييره يُبطل الربط الحالي ويستوجب إعادة الربط من صفحة الإعدادات
GOOGLE_ENC_KEY=

# ─── إشعار المتقدم بالبريد الإلكتروني (اختياري) ──────────────────
# اختيارية بالكامل: إن تُركت فارغة لا يُرسل بريد، ولا يتأثر أي شيء آخر.
#
# كلمة مرور التطبيق من حساب Google Workspace:
#   myaccount.google.com ← Security ← 2-Step Verification ← App passwords
#   (يجب تفعيل التحقق بخطوتين أولاً — كلمة المرور 16 حرفاً بلا مسافات)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# الاسم الظاهر للمُرسِل في صندوق وارد المتقدم
MAIL_FROM_NAME=أرتال للحراسات الأمنية

# ─── إشعار المتقدم بواتساب عبر Chatwoot (اختياري) ────────────────
# اختيارية بالكامل: إن تُركت فارغة لا يُرسل واتساب تلقائي،
# ويبقى زر wa.me اليدوي يعمل كما هو.
#
# INBOX_ID: من Settings ← Inboxes ← افتح صندوق واتساب/Twilio،
#           الرقم في الرابط .../settings/inboxes/{INBOX_ID}
# API_TOKEN: Profile Settings ← Access Token
# ⚠️ الرمز سرّي ويمنح صلاحيات المستخدم كاملة — لا يُكتب إلا هنا
CHATWOOT_HOST=https://app.chat.artal.cloud
CHATWOOT_ACCOUNT_ID=4
CHATWOOT_INBOX_ID=
CHATWOOT_API_TOKEN=

# سرّ استقبال إشعارات التوظيف من نظام أرتال (/api/hooks/*)
# اتركه فارغاً ليستخدم نفس EXT_API_SECRET أعلاه
HOOK_API_SECRET=

# ─── استكمال ملف الموظف (ميزة تجريبية) ────────────────────────
# الميزة تعمل بلا أي مفتاح: يرفع المرشح المستند ويُدخل الحقول يدوياً.
# المفاتيح أدناه تُفعّل القراءة الآلية فقط — أضِفها متى شئت بلا تعديل كود.

# مفتاح Google Cloud Vision (فعّل Vision API في نفس مشروع Google)
GOOGLE_VISION_API_KEY=

# النموذج اللغوي — يُستدعى فقط حين تعجز القواعد المحلية عن حقل مطلوب
# القيم الممكنة: gemini | openai | anthropic
AI_PROVIDER=gemini
AI_API_KEY=
# اتركه معطَّلاً للنموذج الافتراضي الرخيص لكل مزوّد
# AI_MODEL=

# عنوان الموقع لبناء رابط المرشح (مطلوب خلف Nginx)
PUBLIC_BASE_URL=https://jobs.artalsecurity.com

# مفتاح إيقاف الميزة كاملةً بلا نشر كود
ONBOARDING_ENABLED=true

# ─── الإضافة إلى نظام الموظفين (artalsys) ──────────────────────
# نفس السرّ المضبوط على خادم artalsys في ONBOARDING_PUSH_SECRET
ARTALSYS_URL=https://artalsys.com
ARTALSYS_PUSH_SECRET=
# false تُخفي زر المزامنة وتمنع أي نداء صادر
ARTALSYS_SYNC_ENABLED=true

# ─── نسخة الموعد إلى مجموعة واتساب داخلية (WaAPI) ──────────────────────────
# اختيارية بالكامل: إن تُركت فارغة لا تُرسل أي نسخة، ولا يتأثر إشعار المتقدم.
# تُرسل تلقائياً بعد نجاح قالب واتساب للمتقدم (جدولة / إعادة جدولة / إلغاء)،
# وفشلها لا يوقف الجدولة ولا يظهر كفشل قناة في بطاقة المتقدم.
#
# INSTANCE_ID + TOKEN: من لوحة waapi.app ← Instances
WAAPI_INSTANCE_ID=
WAAPI_TOKEN=
# معرّف المجموعة — يقبل أكثر من وجهة مفصولة بفواصل (حتى 5)
WAAPI_GROUP_CHAT_ID=120363429744315607@g.us
# اتركه فارغاً للقيمة الافتراضية https://waapi.app/api/v1
WAAPI_BASE_URL=
