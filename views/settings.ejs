<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>الإعدادات — أرتال Sentinel</title>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"></noscript>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block"></noscript>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f2f4f6; }
    h1,h2,h3 { font-family: 'Manrope', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .field input, .field textarea {
      width: 100%; background: white; border: 1px solid #e0e3e5;
      border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.875rem;
      outline: none; transition: border-color 0.15s; font-family: 'Inter', sans-serif;
    }
    .field input:focus, .field textarea:focus { border-color: #7594ca; box-shadow: 0 0 0 3px rgba(117,148,202,0.15); }
  </style>
</head>
<body class="text-[#191c1e]">
<%- include('partials/sidebar', { currentPage: 'settings' }) %>

<div class="lg:mr-64 min-h-screen pt-14 lg:pt-0">
  <!-- Top bar -->
  <header class="bg-white border-b border-[#eceef0] px-4 lg:px-8 py-4 lg:py-5 sticky top-14 lg:top-0 z-30">
    <h1 class="text-xl font-bold text-[#001736]">الإعدادات</h1>
    <p class="text-xs text-[#43474f] mt-0.5">إدارة بيانات النظام وبيانات التواصل</p>
  </header>

  <main class="p-4 lg:p-8 max-w-2xl space-y-6">

    <!-- Success banners -->
    <% if (success === '1') { %>
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-5 py-3.5 flex items-center gap-2 text-sm">
      <span class="material-symbols-outlined text-base">check_circle</span>
      تم حفظ الإعدادات بنجاح.
    </div>
    <% } %>
    <% if (success === '2') { %>
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-5 py-3.5 flex items-center gap-2 text-sm">
      <span class="material-symbols-outlined text-base">check_circle</span>
      تم تغيير كلمة المرور بنجاح.
    </div>
    <% } %>
    <% if (typeof passwordError !== 'undefined' && passwordError) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-5 py-3.5 flex items-center gap-2 text-sm">
      <span class="material-symbols-outlined text-base">error</span>
      <%= passwordError %>
    </div>
    <% } %>
    <% if (typeof settingsError !== 'undefined' && settingsError) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-5 py-3.5 flex items-center gap-2 text-sm">
      <span class="material-symbols-outlined text-base">error</span>
      <%= settingsError %>
    </div>
    <% } %>
    <%
      // رسائل ربط Google — أصناف Tailwind مكتوبة حرفياً (لا تركيب ديناميكي) حتى لا تعتمد على إعادة بناء CSS
      const GOOGLE_MSGS = {
        connected:     { ok: true,  text: 'تم ربط حساب Google بنجاح.' },
        disconnected:  { ok: true,  text: 'تم فصل حساب Google.' },
        denied:        { ok: false, text: 'أُلغيت عملية الربط من صفحة Google.' },
        state:         { ok: false, text: 'انتهت صلاحية طلب الربط أو تعذّر التحقق منه — أعد المحاولة.' },
        norefresh:     { ok: false, text: 'لم يُرجع Google رمز تحديث — أزل صلاحية التطبيق من حساب Google ثم أعد الربط.' },
        notconfigured: { ok: false, text: 'متغيرات Google غير مكتملة في ملف البيئة.' },
        error:         { ok: false, text: 'تعذّر إتمام الربط مع Google — راجع سجل الخادم.' },
      };
      const gm = (typeof googleMsg !== 'undefined' && GOOGLE_MSGS[googleMsg]) ? GOOGLE_MSGS[googleMsg] : null;
    %>
    <% if (gm && gm.ok) { %>
    <div class="bg-green-50 border border-green-200 text-green-700 rounded-xl px-5 py-3.5 flex items-center gap-2 text-sm">
      <span class="material-symbols-outlined text-base">check_circle</span>
      <%= gm.text %>
    </div>
    <% } else if (gm) { %>
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-5 py-3.5 flex items-center gap-2 text-sm">
      <span class="material-symbols-outlined text-base">error</span>
      <%= gm.text %>
    </div>
    <% } %>

    <!-- Contact Info -->
    <div class="bg-white rounded-2xl p-7">
      <h2 class="font-bold text-[#001736] text-base mb-1 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">contact_phone</span>
        بيانات التواصل
      </h2>
      <p class="text-xs text-[#43474f] mb-6">تظهر هذه البيانات في صفحة التأكيد التي يراها المتقدم بعد التسجيل.</p>

      <form method="POST" action="/admin/settings" class="space-y-5">
        <input type="hidden" name="form_section" value="contact">
        <div class="field">
          <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">اسم الشركة</label>
          <input type="text" name="company_name" value="<%= settings.company_name %>" placeholder="Artal Security Guards">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm">call</span>
              رقم الهاتف
            </label>
            <input type="text" name="phone" value="<%= settings.phone %>" placeholder="+966 500 000 000" dir="ltr">
          </div>
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
              <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[#25D366]">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              واتساب
            </label>
            <input type="text" name="whatsapp" value="<%= settings.whatsapp || '' %>" placeholder="+966 500 000 000" dir="ltr">
          </div>
        </div>
        <div class="field">
          <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
            <span class="material-symbols-outlined text-sm">mail</span>
            البريد الإلكتروني
          </label>
          <input type="email" name="email" value="<%= settings.email %>" placeholder="recruitment@example.com" dir="ltr">
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm">location_on</span>
              نص العنوان
            </label>
            <input type="text" name="address" value="<%= settings.address %>" placeholder="الرياض، المملكة العربية السعودية">
          </div>
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5 flex items-center gap-1.5">
              <span class="material-symbols-outlined text-sm">map</span>
              رابط الموقع على الخريطة
            </label>
            <input type="url" name="maps_url" value="<%= settings.maps_url || '' %>"
                   placeholder="https://maps.app.goo.gl/..." dir="ltr">
            <p class="text-[10px] text-[#7594ca] mt-1.5">
              افتح Google Maps ← اضغط مشاركة ← انسخ الرابط
            </p>
          </div>
        </div>

        <!-- Accepting applications toggle -->
        <div class="flex items-center justify-between p-4 bg-[#f8f9fb] rounded-xl">
          <div>
            <div class="text-sm font-semibold text-[#001736]">استقبال الطلبات</div>
            <div class="text-xs text-[#43474f] mt-0.5">عند الإيقاف، ستظهر صفحة "التوظيف متوقف مؤقتاً"</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="accepting_applications" value="true"
                   class="sr-only peer"
                   <%= settings.accepting_applications === 'true' ? 'checked' : '' %>>
            <div class="w-12 h-6 bg-[#e0e3e5] peer-focus:outline-none rounded-full peer
                        peer-checked:after:translate-x-full peer-checked:after:border-white
                        after:content-[''] after:absolute after:top-[2px] after:right-[2px]
                        after:bg-white after:border-gray-300 after:border after:rounded-full
                        after:h-5 after:w-5 after:transition-all peer-checked:bg-[#001736]"></div>
          </label>
        </div>

        <button type="submit"
                class="w-full bg-[#001736] text-white font-bold py-3.5 rounded-xl hover:bg-[#002b5b] transition-colors flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">save</span>
          حفظ الإعدادات
        </button>
      </form>
    </div>

    <!-- Google Meet integration -->
    <% const gc = (typeof googleConn !== 'undefined' && googleConn) ? googleConn : { configured:false, connected:false, email:'', connectedAt:'', status:'' }; %>
    <div class="bg-white rounded-2xl p-7" id="google">
      <h2 class="font-bold text-[#001736] text-base mb-1 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">videocam</span>
        تكامل Google Meet
      </h2>
      <p class="text-xs text-[#43474f] mb-6">
        يُربط حساب Google Workspace واحد مخصص للمقابلات — تُنشأ كل الاجتماعات في تقويمه وتُقرأ منه الأوقات المشغولة.
      </p>

      <% if (typeof interviewsReady !== 'undefined' && !interviewsReady) { %>
      <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-xs mb-5 flex items-start gap-2">
        <span class="material-symbols-outlined text-base">error</span>
        <span>تعذّر تهيئة جدول المقابلات في قاعدة البيانات — الميزة معطّلة. راجع سجل الخادم (بقية النظام يعمل طبيعياً).</span>
      </div>
      <% } %>

      <% if (!gc.configured) { %>
      <div class="bg-[#f8f9fb] border border-[#e0e3e5] rounded-xl px-4 py-4 text-xs text-[#43474f] leading-relaxed">
        <div class="font-semibold text-[#001736] mb-2">الإعداد غير مكتمل</div>
        أضف هذه المتغيرات إلى ملف <span dir="ltr" class="font-mono">.env</span> ثم أعد تشغيل الخادم:
        <ul class="mt-2 space-y-1 font-mono text-[11px]" dir="ltr">
          <li>GOOGLE_CLIENT_ID</li>
          <li>GOOGLE_CLIENT_SECRET</li>
          <li>GOOGLE_REDIRECT_URI</li>
          <li>GOOGLE_ENC_KEY</li>
        </ul>
      </div>
      <% } else if (!gc.connected) { %>
      <a href="/admin/google/connect"
         class="w-full bg-[#001736] text-white font-bold py-3.5 rounded-xl hover:bg-[#002b5b] transition-colors flex items-center justify-center gap-2">
        <span class="material-symbols-outlined text-base">link</span>
        ربط حساب Google
      </a>
      <p class="text-[10px] text-[#7594ca] mt-2.5 text-center">سجّل الدخول بالحساب المخصص للمقابلات (وليس بحسابك الشخصي).</p>
      <% } else { %>
        <% if (gc.status === 'invalid') { %>
        <div class="bg-red-50 border border-red-200 text-red-700 rounded-xl px-4 py-3 text-xs mb-4 flex items-start gap-2">
          <span class="material-symbols-outlined text-base">error</span>
          <span>انتهت صلاحية الربط بحساب Google — أعد الربط لاستئناف الجدولة. المقابلات المجدولة وروابطها تبقى تعمل.</span>
        </div>
        <% } %>
        <div class="flex items-center justify-between p-4 bg-[#f8f9fb] rounded-xl mb-4">
          <div>
            <div class="text-sm font-semibold text-[#001736]" dir="ltr"><%= gc.email || 'حساب Google' %></div>
            <div class="text-xs text-[#43474f] mt-0.5">
              <% if (gc.connectedAt) { %>مُتصل منذ <%= fmtDateTime(gc.connectedAt) %><% } else { %>مُتصل<% } %>
            </div>
          </div>
          <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= gc.status === 'invalid' ? 'bg-red-50 text-red-700' : 'bg-green-50 text-green-700' %>">
            <%= gc.status === 'invalid' ? 'يحتاج إعادة ربط' : 'متصل' %>
          </span>
        </div>
        <div class="flex gap-3">
          <a href="/admin/google/connect"
             class="flex-1 border border-[#e0e3e5] text-[#001736] font-semibold py-3 rounded-xl hover:bg-[#f8f9fb] transition-colors flex items-center justify-center gap-2 text-sm">
            <span class="material-symbols-outlined text-base">refresh</span>
            إعادة الربط
          </a>
          <button type="button" onclick="disconnectGoogle()"
                  class="flex-1 border border-red-200 text-red-600 font-semibold py-3 rounded-xl hover:bg-red-50 transition-colors flex items-center justify-center gap-2 text-sm">
            <span class="material-symbols-outlined text-base">link_off</span>
            فصل الاتصال
          </button>
        </div>
      <% } %>
    </div>

    <!-- Interview scheduling rules -->
    <div class="bg-white rounded-2xl p-7" id="interviews">
      <h2 class="font-bold text-[#001736] text-base mb-1 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">event_available</span>
        قواعد مواعيد المقابلات
      </h2>
      <p class="text-xs text-[#43474f] mb-6">تحدد الأوقات التي تظهر للموظف عند جدولة مقابلة مع متقدم.</p>

      <form method="POST" action="/admin/settings" class="space-y-5" id="iv-rules-form">
        <input type="hidden" name="form_section" value="interviews">

        <div class="flex items-center justify-between p-4 bg-[#f8f9fb] rounded-xl">
          <div>
            <div class="text-sm font-semibold text-[#001736]">تفعيل ميزة المقابلات</div>
            <div class="text-xs text-[#43474f] mt-0.5">عند الإيقاف تختفي أزرار الجدولة فوراً — ولا يتأثر أي جزء آخر من النظام</div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" name="interviews_enabled" value="true" class="sr-only peer"
                   <%= settings.interviews_enabled === 'true' ? 'checked' : '' %>>
            <div class="w-12 h-6 bg-[#e0e3e5] peer-focus:outline-none rounded-full peer
                        peer-checked:after:translate-x-full peer-checked:after:border-white
                        after:content-[''] after:absolute after:top-[2px] after:right-[2px]
                        after:bg-white after:border-gray-300 after:border after:rounded-full
                        after:h-5 after:w-5 after:transition-all peer-checked:bg-[#001736]"></div>
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">مدة المقابلة</label>
            <select name="interview_duration" style="width:100%;background:white;border:1px solid #e0e3e5;border-radius:.75rem;padding:.75rem 1rem;font-size:.875rem;outline:none;">
              <% [10,15,20,30].forEach(function(d){ %>
              <option value="<%= d %>" <%= String(settings.interview_duration || '15') === String(d) ? 'selected' : '' %>><%= d %> دقيقة</option>
              <% }); %>
            </select>
          </div>
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">عدد الأيام المعروضة</label>
            <input type="number" name="interview_horizon_days" min="1" max="60" value="<%= settings.interview_horizon_days || '14' %>">
          </div>
        </div>

        <div>
          <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-2">أيام العمل</label>
          <%
            const IV_DAYS = ['الأحد','الإثنين','الثلاثاء','الأربعاء','الخميس','الجمعة','السبت'];
            const ivSelected = String(settings.interview_work_days || '0,1,2,3,4,6').split(',');
          %>
          <div class="flex flex-wrap gap-2" id="iv-days">
            <% IV_DAYS.forEach(function(name, i){ var on = ivSelected.indexOf(String(i)) !== -1; %>
            <button type="button" data-day="<%= i %>" data-on="<%= on ? '1' : '0' %>"
                    style="border-radius:9999px;padding:.4rem .9rem;font-size:.8rem;font-weight:600;border:1px solid <%= on ? '#001736' : '#e0e3e5' %>;background:<%= on ? '#001736' : '#fff' %>;color:<%= on ? '#fff' : '#43474f' %>;cursor:pointer;">
              <%= name %>
            </button>
            <% }); %>
          </div>
          <!-- خانات الاختيار غير المؤشَّرة لا تُرسَل، فنستخدم حقلاً مخفياً يحمل القيمة كاملة -->
          <input type="hidden" name="interview_work_days" id="iv-days-value" value="<%= ivSelected.join(',') %>">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">من الساعة</label>
            <input type="time" name="interview_start_hour" value="<%= settings.interview_start_hour || '09:00' %>" dir="ltr">
          </div>
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">إلى الساعة</label>
            <input type="time" name="interview_end_hour" value="<%= settings.interview_end_hour || '17:00' %>" dir="ltr">
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">فاصل بين المقابلات (دقيقة)</label>
            <input type="number" name="interview_buffer" min="0" max="60" value="<%= settings.interview_buffer || '0' %>">
          </div>
          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">أقل مهلة قبل الحجز (دقيقة)</label>
            <input type="number" name="interview_lead_min" min="0" max="10080" value="<%= settings.interview_lead_min || '120' %>">
            <p class="text-[10px] text-[#7594ca] mt-1.5">مثال: 120 = لا يمكن حجز موعد خلال الساعتين القادمتين</p>
          </div>
        </div>

        <button type="submit"
                class="w-full bg-[#001736] text-white font-bold py-3.5 rounded-xl hover:bg-[#002b5b] transition-colors flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">save</span>
          حفظ قواعد المواعيد
        </button>
      </form>
    </div>

    <!-- Applicant notifications (WhatsApp + Email) -->
    <%
      const ms = typeof mailStatus     !== 'undefined' ? mailStatus     : { configured: false, installed: false };
      const cs = typeof chatwootStatus !== 'undefined' ? chatwootStatus : { configured: false };
      const MV = typeof msgVars !== 'undefined' ? msgVars : {};
      const KINDS = [
        { key: 'scheduled',   label: 'عند جدولة مقابلة',   hint: 'الإشعار الأساسي — يحمل الموعد ورابط Meet' },
        { key: 'rescheduled', label: 'عند إعادة الجدولة',  hint: 'اتركه فارغاً لتعطيل واتساب في هذه الحالة' },
        { key: 'cancelled',   label: 'عند إلغاء المقابلة', hint: 'اتركه فارغاً لتعطيل واتساب في هذه الحالة' },
      ].concat((typeof waTemplateList !== 'undefined' ? waTemplateList : [])
        .map(function (t) { return { key: t.key, label: t.settingsLabel, hint: t.settingsHint }; }));
    %>
    <div class="bg-white rounded-2xl p-7" id="notify">
      <h2 class="font-bold text-[#001736] text-base mb-1 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">campaign</span>
        إشعار المتقدم بالموعد
      </h2>
      <p class="text-xs text-[#43474f] mb-6">
        عند تأكيد الجدولة تُرسَل رسالة واتساب وبريد إلكتروني للمتقدم تلقائياً — كلٌ حسب توفر رقمه وبريده.
      </p>

      <!-- حالة القناتين -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="border border-[#e0e3e5] rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-[#001736] flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">mail</span> البريد (SMTP)
            </div>
            <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= ms.configured ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700' %>">
              <%= ms.configured ? 'جاهز' : 'غير مكتمل' %>
            </span>
          </div>
          <% if (ms.configured) { %>
          <div class="text-xs text-[#43474f]" dir="ltr"><%= ms.user %> · <%= ms.host %>:<%= ms.port %></div>
          <div class="flex gap-2 mt-3">
            <input type="email" id="mail-test-to" placeholder="بريد للاختبار" dir="ltr"
                   style="flex:1;border:1px solid #e0e3e5;border-radius:.6rem;padding:.5rem .7rem;font-size:.75rem;outline:none;">
            <button type="button" onclick="notifyTest('email', this)"
                    style="background:#001736;color:#fff;border:none;border-radius:.6rem;padding:.5rem .9rem;font-size:.75rem;font-weight:600;cursor:pointer;white-space:nowrap;">إرسال اختبار</button>
          </div>
          <% } else { %>
          <div class="text-xs text-[#43474f] leading-relaxed">
            أضف إلى <span dir="ltr" class="font-mono">.env</span>:
            <span dir="ltr" class="font-mono text-[11px]">SMTP_USER</span> و<span dir="ltr" class="font-mono text-[11px]">SMTP_PASS</span>
            (كلمة مرور تطبيق من حساب Google).
          </div>
          <% } %>
        </div>

        <div class="border border-[#e0e3e5] rounded-xl p-4">
          <div class="flex items-center justify-between mb-2">
            <div class="text-sm font-semibold text-[#001736] flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base">chat</span> واتساب (Chatwoot)
            </div>
            <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full <%= cs.configured ? 'bg-green-50 text-green-700' : 'bg-amber-50 text-amber-700' %>">
              <%= cs.configured ? 'جاهز' : 'غير مكتمل' %>
            </span>
          </div>
          <% if (cs.configured) { %>
          <div class="text-xs text-[#43474f]" dir="ltr"><%= cs.host %> · account <%= cs.account %> · inbox <%= cs.inbox %></div>
          <div class="flex gap-2 mt-3">
            <input type="text" id="wa-test-to" placeholder="جوال للاختبار — 05xxxxxxxx" dir="ltr"
                   style="flex:1;border:1px solid #e0e3e5;border-radius:.6rem;padding:.5rem .7rem;font-size:.75rem;outline:none;">
            <button type="button" onclick="notifyTest('whatsapp', this)"
                    style="background:#001736;color:#fff;border:none;border-radius:.6rem;padding:.5rem .9rem;font-size:.75rem;font-weight:600;cursor:pointer;white-space:nowrap;">إرسال اختبار</button>
          </div>
          <% } else { %>
          <div class="text-xs text-[#43474f] leading-relaxed">
            أضف إلى <span dir="ltr" class="font-mono">.env</span>:
            <span dir="ltr" class="font-mono text-[11px]">CHATWOOT_INBOX_ID</span> و<span dir="ltr" class="font-mono text-[11px]">CHATWOOT_API_TOKEN</span>.
          </div>
          <% } %>
        </div>
      </div>

      <form method="POST" action="/admin/settings" class="space-y-5">
        <input type="hidden" name="form_section" value="notifications">

        <div class="space-y-3">
          <% [
            ['notify_email_enabled',      'إرسال بريد إلكتروني للمتقدم', 'يُرسَل فقط إذا سجّل المتقدم بريده عند التقديم'],
            ['notify_whatsapp_enabled',   'إرسال واتساب للمتقدم',        'يتطلب قالباً معتمداً في Twilio/Meta — لا تفعّله قبل الاعتماد'],
            ['notify_applicant_attendee', 'دعوة المتقدم في تقويم Google', 'يصله مرفق .ics وتذكيرات Google، ويتحدّث تلقائياً عند إعادة الجدولة'],
          ].forEach(function (f) { %>
          <div class="flex items-center justify-between p-4 bg-[#f8f9fb] rounded-xl">
            <div class="pl-3">
              <div class="text-sm font-semibold text-[#001736]"><%= f[1] %></div>
              <div class="text-xs text-[#43474f] mt-0.5"><%= f[2] %></div>
            </div>
            <label class="relative inline-flex items-center cursor-pointer shrink-0">
              <input type="checkbox" name="<%= f[0] %>" value="true" class="sr-only peer"
                     <%= settings[f[0]] === 'true' ? 'checked' : '' %>>
              <div class="w-12 h-6 bg-[#e0e3e5] peer-focus:outline-none rounded-full peer
                          peer-checked:after:translate-x-full peer-checked:after:border-white
                          after:content-[''] after:absolute after:top-[2px] after:right-[2px]
                          after:bg-white after:border-gray-300 after:border after:rounded-full
                          after:h-5 after:w-5 after:transition-all peer-checked:bg-[#001736]"></div>
            </label>
          </div>
          <% }); %>
        </div>

        <div class="border-t border-[#e0e3e5] pt-5">
          <div class="text-sm font-bold text-[#001736] mb-1">قوالب واتساب المعتمدة</div>
          <p class="text-xs text-[#43474f] mb-4 leading-relaxed">
            واتساب لا يسمح ببدء محادثة خارج نافذة الـ 24 ساعة إلا بقالب معتمد. اكتب اسم القالب كما هو حرفياً في Twilio،
            ورتّب المتغيّرات بحسب <span dir="ltr" class="font-mono">{{1}}</span>، <span dir="ltr" class="font-mono">{{2}}</span> … في نص القالب.
          </p>

          <div class="bg-[#f8f9fb] rounded-xl p-4 mb-4">
            <div class="text-[11px] font-semibold text-[#43474f] mb-2">المتغيّرات المتاحة (افصل بينها بفاصلة):</div>
            <div class="flex flex-wrap gap-1.5">
              <% Object.entries(MV).forEach(function (e) { %>
              <span class="bg-white border border-[#e0e3e5] rounded-full px-2.5 py-1 text-[11px] text-[#43474f]">
                <span dir="ltr" class="font-mono text-[#405f91]"><%= e[0] %></span> — <%= e[1] %>
              </span>
              <% }); %>
            </div>
          </div>

          <% KINDS.forEach(function (k) { %>
          <div class="border border-[#e0e3e5] rounded-xl p-4 mb-3">
            <div class="text-xs font-bold text-[#001736] mb-0.5"><%= k.label %></div>
            <div class="text-[11px] text-[#43474f] mb-3"><%= k.hint %></div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div class="field md:col-span-2">
                <label class="block text-[10px] text-[#43474f] font-semibold uppercase tracking-wider mb-1">اسم القالب</label>
                <input type="text" name="wa_tpl_<%= k.key %>_name" dir="ltr" placeholder="interview_scheduled"
                       value="<%= settings['wa_tpl_' + k.key + '_name'] || '' %>">
              </div>
              <div class="field">
                <label class="block text-[10px] text-[#43474f] font-semibold uppercase tracking-wider mb-1">اللغة</label>
                <input type="text" name="wa_tpl_<%= k.key %>_lang" dir="ltr" placeholder="ar"
                       value="<%= settings['wa_tpl_' + k.key + '_lang'] || 'ar' %>">
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-3">
              <div class="field">
                <label class="block text-[10px] text-[#43474f] font-semibold uppercase tracking-wider mb-1">التصنيف</label>
                <select name="wa_tpl_<%= k.key %>_cat" dir="ltr"
                        style="width:100%;background:white;border:1px solid #e0e3e5;border-radius:.75rem;padding:.75rem 1rem;font-size:.875rem;outline:none;">
                  <% ['UTILITY','MARKETING','AUTHENTICATION'].forEach(function (c) { %>
                  <option value="<%= c %>" <%= (settings['wa_tpl_' + k.key + '_cat'] || 'UTILITY') === c ? 'selected' : '' %>><%= c %></option>
                  <% }); %>
                </select>
              </div>
              <div class="field md:col-span-2">
                <label class="block text-[10px] text-[#43474f] font-semibold uppercase tracking-wider mb-1">ترتيب المتغيّرات</label>
                <input type="text" name="wa_tpl_<%= k.key %>_vars" dir="ltr" placeholder="name,date,time,link"
                       value="<%= settings['wa_tpl_' + k.key + '_vars'] || '' %>">
              </div>
            </div>
          </div>
          <% }); %>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-5">
            <div class="field">
              <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">المسمّى الوظيفي الافتراضي</label>
              <input type="text" name="default_job_title" maxlength="100" placeholder="حارس أمن"
                     value="<%= settings.default_job_title || '' %>">
              <p class="text-[10px] text-[#7594ca] mt-1.5 leading-relaxed">
                يُستخدم حين يتعذّر استنتاج الوظيفة من صفحة التقديم، ويظهر مُعبَّأً مسبقاً ليعدّله الموظف.
              </p>
            </div>
            <div class="field">
              <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">المشروع الافتراضي</label>
              <input type="text" name="default_project_name" maxlength="100" placeholder="اسم المشروع"
                     value="<%= settings.default_project_name || '' %>">
              <p class="text-[10px] text-[#7594ca] mt-1.5 leading-relaxed">
                يُعبَّأ مسبقاً في نافذة طلب استكمال البيانات — وفّر على الموظف كتابته لكل متقدم.
              </p>
            </div>
          </div>

          <div class="field">
            <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">شكل المتغيّرات في Chatwoot</label>
            <select name="wa_params_shape"
                    style="width:100%;background:white;border:1px solid #e0e3e5;border-radius:.75rem;padding:.75rem 1rem;font-size:.875rem;outline:none;">
              <option value="numbered"   <%= settings.wa_params_shape !== 'structured' ? 'selected' : '' %>>ترقيم بسيط — {"1": "…", "2": "…"}</option>
              <option value="structured" <%= settings.wa_params_shape === 'structured' ? 'selected' : '' %>>بنية مكوّنات — {"body": […]}</option>
            </select>
            <p class="text-[10px] text-[#7594ca] mt-1.5 leading-relaxed">
              يختلف بين إصدارات Chatwoot. إن فشل الإرسال بخطأ عدد المتغيّرات، أرسل القالب يدوياً مرة من واجهة Chatwoot
              ثم اقرأ بنية <span dir="ltr" class="font-mono">template_params</span> الفعلية من الـ API وطابِق الاختيار عليها.
            </p>
          </div>
        </div>

        <button type="submit"
                class="w-full bg-[#001736] text-white font-bold py-3.5 rounded-xl hover:bg-[#002b5b] transition-colors flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">save</span>
          حفظ إعدادات الإشعار
        </button>
      </form>
    </div>

    <!-- Change Password -->
    <div class="bg-white rounded-2xl p-7">
      <h2 class="font-bold text-[#001736] text-base mb-1 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">lock_reset</span>
        تغيير كلمة المرور
      </h2>
      <p class="text-xs text-[#43474f] mb-6">كلمة المرور الجديدة يجب أن تكون 8 أحرف على الأقل.</p>

      <form method="POST" action="/admin/settings/password" class="space-y-5">
        <div class="field">
          <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">كلمة المرور الحالية</label>
          <input type="password" name="current_password" required autocomplete="current-password">
        </div>
        <div class="field">
          <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">كلمة المرور الجديدة</label>
          <input type="password" name="new_password" required minlength="8" autocomplete="new-password">
        </div>
        <div class="field">
          <label class="block text-xs text-[#43474f] font-semibold uppercase tracking-wider mb-1.5">تأكيد كلمة المرور</label>
          <input type="password" name="confirm_password" required minlength="8" autocomplete="new-password">
        </div>
        <button type="submit"
                class="w-full bg-[#002b5b] text-white font-bold py-3.5 rounded-xl hover:bg-[#003a7a] transition-colors flex items-center justify-center gap-2">
          <span class="material-symbols-outlined text-base">lock_reset</span>
          تغيير كلمة المرور
        </button>
      </form>
    </div>

    <!-- System Info -->
    <div class="bg-white rounded-2xl p-7">
      <h2 class="font-bold text-[#001736] text-base mb-4 flex items-center gap-2">
        <span class="material-symbols-outlined text-lg">info</span>
        معلومات النظام
      </h2>
      <div class="space-y-3 text-sm">
        <div class="flex justify-between items-center py-2 border-b border-[#f2f4f6]">
          <span class="text-[#43474f]">الإصدار</span>
          <span class="font-mono text-[#001736]">1.0.0</span>
        </div>
        <div class="flex justify-between items-center py-2 border-b border-[#f2f4f6]">
          <span class="text-[#43474f]">المستخدم الحالي</span>
          <span class="font-medium text-[#001736]"><%= adminUser %></span>
        </div>
        <div class="flex justify-between items-center py-2">
          <span class="text-[#43474f]">حالة استقبال الطلبات</span>
          <% if (settings.accepting_applications === 'true') { %>
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-700">مفعّل</span>
          <% } else { %>
          <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-700">موقوف</span>
          <% } %>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
  // ─── شرائح أيام العمل — تُحدّث الحقل المخفي (خانة غير مؤشَّرة لا تُرسَل أصلاً)
  (function () {
    const wrap  = document.getElementById('iv-days');
    const field = document.getElementById('iv-days-value');
    if (!wrap || !field) return;

    function paint(btn, on) {
      btn.dataset.on = on ? '1' : '0';
      btn.style.background  = on ? '#001736' : '#fff';
      btn.style.color       = on ? '#fff' : '#43474f';
      btn.style.borderColor = on ? '#001736' : '#e0e3e5';
    }
    function sync() {
      const days = [...wrap.querySelectorAll('button[data-day]')]
        .filter(b => b.dataset.on === '1')
        .map(b => b.dataset.day);
      field.value = days.join(',');
    }
    wrap.addEventListener('click', (e) => {
      const btn = e.target.closest('button[data-day]');
      if (!btn) return;
      paint(btn, btn.dataset.on !== '1');
      sync();
    });

    const form = document.getElementById('iv-rules-form');
    if (form) form.addEventListener('submit', (e) => {
      sync();
      if (!field.value) { e.preventDefault(); alert('اختر يوم عمل واحداً على الأقل'); }
    });
  })();

  // اختبار قناة الإشعار — يُرسل على بيانات مقابلة وهمية
  function notifyTest(channel, btn) {
    const input = document.getElementById(channel === 'email' ? 'mail-test-to' : 'wa-test-to');
    const target = (input && input.value || '').trim();
    if (!target) { alert('أدخل وجهة الاختبار أولاً'); if (input) input.focus(); return; }

    const old = btn.textContent;
    btn.disabled = true; btn.textContent = 'جارٍ الإرسال…'; btn.style.opacity = '.6';

    fetch('/admin/settings/notify-test', {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ channel, target }),
    })
      .then(r => r.json().then(d => ({ ok: r.ok, d })))
      .then(({ ok, d }) => alert(ok ? (d.message || 'تم الإرسال') : ('فشل الإرسال: ' + (d.error || 'خطأ غير معروف'))))
      .catch(() => alert('تعذّر الاتصال بالخادم'))
      .finally(() => { btn.disabled = false; btn.textContent = old; btn.style.opacity = '1'; });
  }

  function disconnectGoogle() {
    if (!confirm('فصل حساب Google؟ لن تتمكن من جدولة مقابلات جديدة حتى تعيد الربط.')) return;
    fetch('/admin/google/disconnect', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
      .then(r => r.json())
      .then(d => { location.href = d.ok ? '/admin/settings?google=disconnected' : '/admin/settings?google=error'; })
      .catch(() => { location.href = '/admin/settings?google=error'; });
  }
</script>
</body>
</html>
