<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ملف الاستكمال — <%= applicant.full_name %></title>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"></noscript>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block"></noscript>
  <!--
    تنسيق الصفحة مكتوب هنا لا في tailwind.css المُجمَّع: هذه صفحة تجريبية،
    وإعادة بناء ملف CSS تُحمّله كل صفحات النظام لأجلها مخاطرة بلا داعٍ.
  -->
  <style>
    body{font-family:'Inter',sans-serif;background:#f2f4f6}
    h1,h2,h3{font-family:'Manrope',sans-serif}
    .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
    .ob-card{background:#fff;border:1px solid #eceef0;border-radius:16px}
    .ob-chip{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;
             padding:4px 10px;border-radius:99px;white-space:nowrap}
    .g{background:#dcfce7;color:#15803d} .y{background:#fef3c7;color:#a16207}
    .r{background:#ffdad6;color:#ba1a1a} .n{background:#eceef0;color:#43474f}
    .ob-tbl{width:100%;border-collapse:collapse;font-size:13px}
    .ob-tbl th{text-align:right;font-weight:600;color:#43474f;padding:7px 10px;background:#f8f9fb;font-size:12px}
    .ob-tbl td{padding:8px 10px;border-top:1px solid #eceef0;vertical-align:middle}
    .ob-val{font-weight:600;color:#001736;word-break:break-all}
    .ob-src{font-size:11px;color:#747780}
    .ob-btn{display:inline-flex;align-items:center;gap:6px;border:0;border-radius:10px;padding:8px 14px;
            font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
    .ob-btn.p{background:#001736;color:#fff} .ob-btn.s{background:#eef2f7;color:#001736}
    .ob-btn.d{background:#ffdad6;color:#ba1a1a}
    .emp-in{width:100%;border:1.5px solid #e0e3e5;border-radius:10px;padding:9px 11px;font:inherit;
            font-size:13.5px;background:#fff;color:#001736}
    .emp-in:focus{outline:none;border-color:#264778}
    .ob-link{background:#f8f9fb;border:1px dashed #c4c6d0;border-radius:12px;padding:10px 12px;
             font-size:12.5px;color:#43474f;word-break:break-all;font-family:ui-monospace,monospace}
  </style>
</head>
<body class="text-[#191c1e]">
<%- include('partials/sidebar', { currentPage: 'applicants' }) %>

<div class="lg:mr-64 min-h-screen pt-14 lg:pt-0">
  <header class="bg-white border-b border-[#eceef0] px-4 lg:px-8 py-3 lg:py-4 flex items-center gap-4 sticky top-14 lg:top-0 z-30">
    <a href="/admin/applicants/<%= applicant.id %>" class="text-[#43474f] hover:text-[#001736]">
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <div class="flex-1 min-w-0">
      <h1 class="text-base lg:text-lg font-bold text-[#001736] truncate">ملف الاستكمال — <%= applicant.full_name %></h1>
      <p class="text-xs text-[#43474f]">مستندات وبيانات يرفعها المرشح بنفسه — لا تُكتب في بيانات الطلب إلا بقرارك.</p>
    </div>
    <span class="ob-chip n">تجريبي</span>
  </header>

  <main class="p-4 lg:p-8 max-w-5xl space-y-4">

    <!-- ── محرّك القراءة ─────────────────────────────────────────── -->
    <div class="ob-card p-4 flex flex-wrap items-center gap-3 text-xs text-[#43474f]">
      <span class="font-semibold text-[#001736]">محرّك القراءة:</span>
      <span class="ob-chip <%= engine.ocr ? 'g' : 'n' %>">
        <%= engine.ocr ? 'Google Vision مفعّل' : 'OCR غير مفعّل — إدخال يدوي' %>
      </span>
      <span class="ob-chip <%= engine.ai ? 'g' : 'n' %>">
        <%= engine.ai ? `الذكاء الاصطناعي: ${engine.aiProvider} / ${engine.aiModel}` : 'الذكاء الاصطناعي غير مفعّل' %>
      </span>
      <span class="text-[11px]">النموذج لا يُستدعى إلا حين تعجز القواعد المحلية عن حقل مطلوب.</span>
    </div>

    <% if (!session) { %>
      <!-- ── لا رحلة بعد ──────────────────────────────────────────── -->
      <div class="ob-card p-8 text-center">
        <span class="material-symbols-outlined text-4xl text-[#7594ca]">folder_shared</span>
        <h2 class="text-lg font-bold text-[#001736] mt-3">لم يبدأ هذا المرشح رحلة الاستكمال</h2>
        <p class="text-sm text-[#43474f] mt-2 mb-5">
          أنشئ رابطاً سرياً وأرسله له — يرفع مستنداته من جواله، وتظهر نتائجها هنا.
        </p>
        <button class="ob-btn p" onclick="createLink()">
          <span class="material-symbols-outlined" style="font-size:18px">link</span> إنشاء رابط الاستكمال
        </button>
      </div>
    <% } else { %>
      <!-- ── الرابط والتقدّم ──────────────────────────────────────── -->
      <div class="ob-card p-4 lg:p-5">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
          <div>
            <div class="text-sm font-bold text-[#001736]">رابط المرشح</div>
            <div class="text-xs text-[#43474f]">
              <% if (session.revoked_at) { %>موقوف<% } else if (session.expires_at && new Date(session.expires_at) < new Date()) { %>
                منتهي الصلاحية
              <% } else { %>
                صالح حتى <%= fmtDate(session.expires_at) %> · <%= session.opened_at ? 'فُتح ' + fmtDateTime(session.opened_at) : 'لم يُفتح بعد' %>
              <% } %>
            </div>
          </div>
          <div class="flex gap-2 flex-wrap">
            <button class="ob-btn s" onclick="copyLink()">
              <span class="material-symbols-outlined" style="font-size:18px">content_copy</span> نسخ
            </button>
            <% if (waReady) { %>
            <!-- القالب المعتمد في ميتا — يصل المتقدم حتى خارج نافذة الـ24 ساعة -->
            <button class="ob-btn p" onclick="obSend(this)">
              <span class="material-symbols-outlined" style="font-size:18px">send</span> إرسال بواتساب
            </button>
            <% } %>
            <!-- خطة بديلة دائمة: واتساب يدوي من جوال الموظف (لا يحتاج قالباً) -->
            <a class="ob-btn s" target="_blank" rel="noopener"
               href="https://wa.me/<%= String(applicant.phone||'').replace(/^0/,'966') %>?text=<%= encodeURIComponent(`مرحباً ${String(applicant.full_name||'').split(' ')[0]}،\nلاستكمال ملفك الوظيفي في شركة أرتال، افتح الرابط التالي وارفع المستندات المطلوبة:\n${link}`) %>">
              <span class="material-symbols-outlined" style="font-size:18px">chat</span> واتساب يدوي
            </a>
            <button class="ob-btn d" onclick="revokeLink(<%= session.id %>)">إيقاف الرابط</button>
          </div>
        </div>
        <div class="ob-link" id="ob-link"><%= link %></div>

        <div class="mt-4">
          <div class="flex justify-between text-xs text-[#43474f] mb-1.5">
            <span>التقدّم</span><span><%= session.progress %>%</span>
          </div>
          <div style="height:8px;background:#eceef0;border-radius:99px;overflow:hidden">
            <div style="height:100%;width:<%= session.progress %>%;background:#001736;border-radius:99px"></div>
          </div>
        </div>
      </div>

      <!-- ── بيانات التوظيف: يملأها فريق الموارد البشرية وحده ────── -->
      <div class="ob-card p-4 lg:p-5">
        <div class="flex items-baseline gap-2 mb-1">
          <h2 class="text-sm font-bold text-[#001736]">بيانات التوظيف</h2>
          <span class="text-[11px] text-[#43474f]">لا تظهر للمرشح — يملأها فريق التوظيف</span>
        </div>
        <p class="text-[11px] text-[#43474f] mb-3">
          ما لا يوجد في مستندات المرشح: الراتب وبدلاته، المسمّى، الموقع، تواريخ العقد.
          الحفظ جزئي — املأ ما لديك الآن وأكمل لاحقاً. الحقول المعلَّمة (*) مطلوبة قبل الإضافة للنظام.
        </p>

        <form id="emp-form" onsubmit="saveEmployment(event)"
              class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          <% empFields.forEach(function (f) { %>
            <%
              // عمود DATE يعود كائنَ تاريخ من mysql2، و<input type=date> لا يقبل
              // إلا YYYY-MM-DD — بدون هذا التحويل يظهر الحقل فارغاً رغم أنه محفوظ.
              const raw = employment ? (employment[f.key] ?? '') : '';
              const val = (f.type === 'date' && raw) ? new Date(raw).toISOString().slice(0, 10) : raw;
            %>
            <div>
              <label class="block text-[11px] font-semibold text-[#43474f] mb-1" for="emp-<%= f.key %>">
                <%= f.label %><% if (f.required) { %> <span class="text-[#ba1a1a]">*</span><% } %>
              </label>

              <% if (f.type === 'select') { %>
                <select id="emp-<%= f.key %>" name="<%= f.key %>" class="emp-in">
                  <option value="">—</option>
                  <% f.options.forEach(function (o) { %>
                    <option value="<%= o %>" <%= String(val) === o ? 'selected' : '' %>><%= o %></option>
                  <% }) %>
                </select>
              <% } else if (f.type === 'choice') { %>
                <select id="emp-<%= f.key %>" name="<%= f.key %>" class="emp-in">
                  <option value="">—</option>
                  <% f.options.forEach(function (o) { %>
                    <option value="<%= o.value %>" <%= String(val) === o.value ? 'selected' : '' %>><%= o.label %></option>
                  <% }) %>
                </select>
              <% } else { %>
                <input id="emp-<%= f.key %>" name="<%= f.key %>" class="emp-in"
                       type="<%= f.type === 'date' ? 'date' : (f.type === 'money' ? 'number' : 'text') %>"
                       <%= f.type === 'money' ? 'step="0.01" min="0"' : '' %>
                       dir="<%= ['money','date','phone','email'].includes(f.type) ? 'ltr' : 'auto' %>"
                       value="<%= val === null ? '' : val %>">
              <% } %>

              <% if (f.hint) { %><div class="text-[10px] text-[#747780] mt-1"><%= f.hint %></div><% } %>
            </div>
          <% }) %>

          <div class="sm:col-span-2 lg:col-span-3 flex items-center gap-3 flex-wrap pt-1">
            <button type="submit" class="ob-btn p" id="emp-save">
              <span class="material-symbols-outlined" style="font-size:18px">save</span> حفظ بيانات التوظيف
            </button>
            <span id="emp-status" class="text-xs"></span>
          </div>
        </form>

        <div id="emp-missing" class="mt-3 text-[11px] <%= empMissing.length ? '' : 'hidden' %>"
             style="color:#a16207">
          ناقص قبل الإضافة للنظام: <span id="emp-missing-list"><%= empMissing.map(f => f.label).join('، ') %></span>
        </div>
        <% if (employment && employment.updated_by) { %>
          <div class="ob-src mt-2">آخر تعديل: <%= employment.updated_by %> · <%= fmtDateTime(employment.updated_at) %></div>
        <% } %>
      </div>

      <!-- ── الإضافة إلى نظام الموظفين ─────────────────────────────── -->
      <div class="ob-card p-4 lg:p-5" id="sync-card">
        <div class="flex items-baseline gap-2 mb-1">
          <h2 class="text-sm font-bold text-[#001736]">الإضافة إلى نظام الموظفين</h2>
          <span class="text-[11px] text-[#43474f]">artalsys.com</span>
        </div>

        <% const synced = employment && employment.sync_status === 'created' && employment.ext_employee_id; %>
        <% const dup = employment && employment.sync_status === 'duplicate'; %>

        <% if (synced) { %>
          <div class="mt-2 flex items-center gap-2 flex-wrap">
            <span class="ob-chip g">أُضيف إلى النظام</span>
            <span class="text-sm font-bold text-[#001736]">رقم الموظف: <%= employment.ext_employee_id %></span>
            <a class="ob-btn s" target="_blank" rel="noopener"
               href="<%= artalsysUrl %>/admin/employees/<%= employment.ext_employee_id %>/edit">
              <span class="material-symbols-outlined" style="font-size:18px">open_in_new</span> فتح ملفه
            </a>
            <button class="ob-btn s" id="att-sync" onclick="syncAttachments()">
              <span class="material-symbols-outlined" style="font-size:18px">cloud_upload</span> مزامنة المرفقات
            </button>
            <span class="ob-src"><%= fmtDateTime(employment.synced_at) %></span>
          </div>
          <% if (employment.attachments_synced_at) { %>
            <div class="ob-src mt-2">آخر مزامنة للمرفقات: <%= fmtDateTime(employment.attachments_synced_at) %></div>
          <% } %>
          <div id="att-result" class="mt-3 text-xs hidden"></div>
        <% } else { %>
          <p class="text-[11px] text-[#43474f] mb-3">
            «فحص قبل الإضافة» يمرّ بكل التحقق في النظام الأساسي <b>بلا إنشاء أي سجل</b> — فترى النتيجة قبل أن تضغط.
          </p>

          <% if (!artalsysReady) { %>
            <div class="ob-chip n">تكامل النظام الأساسي غير مهيأ — راجع متغيّرات البيئة</div>
          <% } else { %>
            <div class="flex items-center gap-2 flex-wrap">
              <button class="ob-btn s" id="sync-check" onclick="syncPreview()">
                <span class="material-symbols-outlined" style="font-size:18px">fact_check</span> فحص قبل الإضافة
              </button>
              <button class="ob-btn p hidden" id="sync-go" onclick="syncNow()">
                <span class="material-symbols-outlined" style="font-size:18px">person_add</span> إضافة إلى النظام
              </button>
              <% if (dup && employment.ext_employee_id) { %>
                <a class="ob-btn s" target="_blank" rel="noopener"
                   href="<%= artalsysUrl %>/admin/employees/<%= employment.ext_employee_id %>/edit">
                  فتح ملف الموظف القائم (#<%= employment.ext_employee_id %>)
                </a>
                <!-- الهوية مسجّلة موظفاً: لا نُنشئ ولا نعدّل بياناته — نضيف وثائقه فقط، بنقرة صريحة -->
                <button class="ob-btn p" id="att-sync" onclick="syncAttachments()">
                  <span class="material-symbols-outlined" style="font-size:18px">cloud_upload</span> مزامنة المرفقات إلى ملفه
                </button>
              <% } %>
            </div>
          <% } %>

          <% if (employment && employment.sync_error) { %>
            <div class="mt-3 text-xs bg-[#ffdad6] text-[#ba1a1a] rounded-xl px-3 py-2">
              آخر محاولة: <%= employment.sync_error %>
            </div>
          <% } %>

          <div id="sync-result" class="mt-3 text-xs hidden"></div>
          <div id="att-result" class="mt-3 text-xs hidden"></div>
        <% } %>
      </div>

      <!-- ── الملف الموحّد: ما تتفق عليه المستندات وما تختلف فيه ──── -->
      <% if (profile.length) { %>
      <div class="ob-card p-4 lg:p-5">
        <div class="flex items-baseline gap-2 mb-1">
          <h2 class="text-sm font-bold text-[#001736]">الملف الموحّد</h2>
          <span class="text-[11px] text-[#43474f]">البيانات المشتركة بين المستندات</span>
        </div>
        <p class="text-[11px] text-[#43474f] mb-3">
          اتفاق المستندات تأكيدٌ على صحة القراءة. والاختلاف يعني أحد ثلاثة: خطأ قراءة، أو مستند لشخص آخر، أو بيانات قديمة — ولا يُرجَّح آلياً.
        </p>
        <div class="overflow-x-auto">
          <table class="ob-tbl">
            <thead><tr><th>الحقل</th><th>القيمة المعتمدة</th><th>مصدرها</th><th>الحالة</th></tr></thead>
            <tbody>
            <% profile.forEach(function (g) { %>
              <tr>
                <td class="text-[#43474f] whitespace-nowrap"><%= g.label %></td>
                <td class="ob-val"><%= g.chosen.value %></td>
                <td class="ob-src"><%= g.chosen.docLabel %></td>
                <td>
                  <% if (g.conflict) { %>
                    <span class="ob-chip r">اختلاف بين المستندات</span>
                    <div class="mt-1.5 space-y-0.5">
                      <% g.values.forEach(function (v) { %>
                        <div class="ob-src"><%= v.docLabel %>: <span class="text-[#001736] font-semibold"><%= v.value %></span></div>
                      <% }) %>
                    </div>
                  <% } else if (g.values.length > 1) { %>
                    <span class="ob-chip g">متطابق في <%= g.values.length %> مستندات</span>
                  <% } else { %>
                    <span class="ob-chip n">مستند واحد</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      </div>
      <% } %>

      <!-- ── المستندات ────────────────────────────────────────────── -->
      <% steps.forEach(function (s) { %>
        <div class="ob-card p-4 lg:p-5">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-[#eef2f7] text-[#264778] flex items-center justify-center">
                <span class="material-symbols-outlined"><%= s.icon %></span>
              </span>
              <div>
                <div class="font-bold text-[#001736] text-sm"><%= s.label %></div>
                <div class="text-xs text-[#43474f]">
                  <%= s.required ? 'مطلوب' : 'اختياري' %>
                  <% if (s.aiUsed) { %> · <span class="ob-src"><%= s.aiVision ? 'قرأ النموذج الصورة مباشرةً' : 'استُعين بنموذج لغوي' %></span><% } %>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <% if (!s.hasFile && s.existingUrl) { %>
                <span class="ob-chip g">مرفقة بطلب التوظيف</span>
                <a class="ob-btn s" target="_blank" rel="noopener" href="<%= s.existingUrl %>">
                  <span class="material-symbols-outlined" style="font-size:18px">visibility</span> المرفق
                </a>
              <% } else if (!s.hasFile) { %>
                <span class="ob-chip n">لم يُرفع</span>
              <% } else { %>
                <span class="ob-chip <%= s.review === 'green' ? 'g' : (s.review === 'red' ? 'r' : 'y') %>">
                  <%= s.review === 'green' ? 'تم التحقق' : (s.review === 'red' ? 'غير مقبول' : 'يحتاج مراجعة') %>
                </span>
                <% if (s.status === 'confirmed') { %><span class="ob-chip n">أكّده المرشح</span><% } %>
                <% if (s.hrDecidedBy) { %><span class="ob-chip n" title="<%= fmtDateTime(s.hrDecidedAt) %>">اعتمده <%= s.hrDecidedBy %></span><% } %>
                <a class="ob-btn s" target="_blank" rel="noopener" href="/admin/onboarding/file/<%= s.docId %>">
                  <span class="material-symbols-outlined" style="font-size:18px">visibility</span> المرفق
                </a>
                <!-- يعيد تشغيل القراءة على نفس الملف — لا يمسّ ما صحّحه المرشح بيده -->
                <button class="ob-btn s" onclick="reextract(<%= s.docId %>, this)">
                  <span class="material-symbols-outlined" style="font-size:18px">autorenew</span> إعادة الاستخراج
                </button>
              <% } %>
            </div>
          </div>

          <% if (s.hasFile) { %>
            <% if (s.warnings.length) { %>
              <div class="mt-3 text-xs bg-[#fef3c7] text-[#a16207] rounded-xl px-3 py-2 space-y-1">
                <% s.warnings.forEach(function (w) { %><div>⚠️ <%= w %></div><% }) %>
              </div>
            <% } %>

            <% if (s.fields.length) { %>
            <div class="mt-3 overflow-x-auto">
              <table class="ob-tbl">
                <thead><tr><th>الحقل</th><th>القيمة</th><th>المصدر</th><th>القيمة كما قُرئت</th></tr></thead>
                <tbody>
                <% s.fields.forEach(function (f) { %>
                  <tr>
                    <td class="text-[#43474f] whitespace-nowrap"><%= f.label %><%= f.required ? ' *' : '' %></td>
                    <td class="ob-val">
                      <%= f.value || '—' %>
                      <% if (f.value && f.valid === false) { %>
                        <div class="ob-chip r mt-1"><%= f.error || 'غير صالح' %></div>
                      <% } %>
                    </td>
                    <td class="ob-src">
                      <%= { ocr:'قراءة آلية', ai:'نموذج لغوي', user:'أدخله المرشح', rule:'قاعدة النظام' }[f.source] || '—' %>
                      <% if (f.confidence) { %><br><%= Math.round(f.confidence * 100) %>%<% } %>
                    </td>
                    <td class="ob-src"><%= f.raw && f.raw !== f.value ? f.raw : '—' %></td>
                  </tr>
                <% }) %>
                </tbody>
              </table>
            </div>
            <% } else { %>
            <div class="mt-3 text-xs text-[#43474f]">مرفق للمراجعة بالعين — لا حقول تُستخرج منه.</div>
            <% } %>

            <% if (s.ocrText) { %>
            <!-- أداة التشخيص: ما قرأه Vision فعلاً قبل أن تعمل عليه القواعد -->
            <details class="mt-3">
              <summary style="cursor:pointer;font-size:12px;color:#43474f">نص القراءة الخام</summary>
              <pre dir="auto" style="margin:8px 0 0;padding:10px 12px;background:#f8f9fb;border:1px solid #eceef0;
                   border-radius:10px;font-size:11.5px;line-height:1.7;max-height:220px;overflow:auto;
                   white-space:pre-wrap;word-break:break-word;color:#43474f"><%= s.ocrText %></pre>
            </details>
            <% } %>

            <!-- قرار HR — الاستثناءات وحدها تصل إلى إنسان -->
            <div class="mt-3 flex items-center gap-2 flex-wrap">
              <span class="text-xs text-[#43474f]">قرارك:</span>
              <button class="ob-btn s" onclick="review(<%= s.docId %>,'green')">مقبول</button>
              <button class="ob-btn s" onclick="review(<%= s.docId %>,'yellow')">يحتاج مراجعة</button>
              <button class="ob-btn d" onclick="review(<%= s.docId %>,'red')">غير مقبول</button>
              <% if (s.hrNote) { %><span class="ob-src">— <%= s.hrNote %></span><% } %>
            </div>
          <% } %>
        </div>
      <% }) %>

      <% if (history.length) { %>
        <div class="ob-card p-4 lg:p-5">
          <div class="text-sm font-bold text-[#001736] mb-2">نسخ سابقة (سجل تدقيق)</div>
          <div class="text-xs text-[#43474f] mb-3">مستندات استُبدلت بإعادة رفع — محفوظة ولا تُحتسب.</div>
          <table class="ob-tbl">
            <tbody>
            <% history.forEach(function (h) { %>
              <tr>
                <td class="whitespace-nowrap"><%= DOC_TYPES[h.doc_type] ? DOC_TYPES[h.doc_type].label : h.doc_type %></td>
                <td class="ob-src"><%= fmtDateTime(h.created_at) %></td>
                <td><a class="text-[#405f91] underline" target="_blank" rel="noopener" href="/admin/onboarding/file/<%= h.id %>">عرض</a></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>
  </main>
</div>

<script>
const APPLICANT_ID = <%= applicant.id %>;

async function reextract(docId, btn) {
  if (!confirm('إعادة قراءة المستند بالقواعد الحالية؟\nالقيم التي صحّحها المرشح بنفسه لن تتغيّر.')) return;
  const old = btn.innerHTML;
  btn.disabled = true; btn.textContent = 'جارٍ القراءة…';
  try {
    const r = await fetch('/admin/onboarding/doc/' + docId + '/reextract', { method: 'POST' });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || 'تعذّرت إعادة الاستخراج');
    if (!j.changed.length) {
      alert('لا جديد — القيم الحالية مطابقة لما تقرؤه القواعد الآن.'
        + (j.ocrError ? '\n\nتنبيه: ' + j.ocrError : ''));
      btn.disabled = false; btn.innerHTML = old;
      return;
    }
    alert('تحدّث ' + j.changed.length + ' حقل:\n\n'
      + j.changed.map(c => '• ' + c.label + ': ' + (c.from || '—') + '  ←  ' + c.to).join('\n'));
    location.reload();
  } catch (e) {
    alert(e.message);
    btn.disabled = false; btn.innerHTML = old;
  }
}

// ─── المزامنة مع النظام الأساسي ─────────────────────────────────────────────
function syncBox(html, tone) {
  const box = document.getElementById('sync-result');
  const colors = { ok: ['#dcfce7', '#15803d'], warn: ['#fef3c7', '#a16207'], bad: ['#ffdad6', '#ba1a1a'], info: ['#eef2f7', '#43474f'] };
  const [bg, fg] = colors[tone] || colors.info;
  box.style.background = bg; box.style.color = fg;
  box.style.borderRadius = '12px'; box.style.padding = '10px 12px';
  box.innerHTML = html;
  box.classList.remove('hidden');
}

async function syncPreview() {
  const btn = document.getElementById('sync-check');
  btn.disabled = true;
  syncBox('جارٍ الفحص…', 'info');
  try {
    const r = await fetch('/admin/onboarding/sync-preview/' + APPLICANT_ID);
    const j = await r.json();
    if (!r.ok) throw new Error(j.error || 'تعذّر الفحص');

    if (j.blockers.length) {
      syncBox('<b>لا يمكن الإضافة بعد:</b><ul style="margin:6px 0 0;padding-inline-start:18px">'
        + j.blockers.map(b => '<li>' + b + '</li>').join('') + '</ul>', 'warn');
      document.getElementById('sync-go').classList.add('hidden');
      return;
    }

    const rem = j.remote || {};
    if (rem.status === 409) {
      const c = rem.conflicts || {};
      const lines = Object.values(c).map(x => '• ' + x.message
        + (x.employee_id ? ' (موظف رقم ' + x.employee_id + (x.name ? ' — ' + x.name : '') + ')' : ''));
      syncBox('<b>تعارض يمنع الإضافة:</b><br>' + lines.join('<br>'), 'bad');
      document.getElementById('sync-go').classList.add('hidden');
      return;
    }
    if (rem.status === 422) {
      const errs = Object.values(rem.errors || {}).flat();
      syncBox('<b>رفض النظام الأساسي البيانات:</b><br>' + errs.join('<br>'), 'bad');
      document.getElementById('sync-go').classList.add('hidden');
      return;
    }
    if (rem.status !== 200 || !rem.ok) {
      syncBox(rem.error || 'رد غير متوقع من النظام الأساسي', 'bad');
      return;
    }

    const e = rem.employee || {};
    syncBox('<b>جاهز للإضافة ✓</b> — سيُنشأ باسم «' + (e.first_name || '') + ' ' + (e.family_name || '')
      + '» · هوية ' + (e.national_id || '') + ' · ' + (e.job_title || '') + ' · راتب ' + (e.basic_salary || 0), 'ok');
    document.getElementById('sync-go').classList.remove('hidden');
  } catch (err) {
    syncBox(err.message, 'bad');
  } finally {
    btn.disabled = false;
  }
}

async function syncNow() {
  if (!confirm('إضافة هذا المرشح إلى نظام الموظفين؟\nيُنشأ سجل موظف حقيقي في artalsys.')) return;
  const btn = document.getElementById('sync-go');
  btn.disabled = true;
  syncBox('جارٍ الإضافة…', 'info');
  try {
    const r = await fetch('/admin/onboarding/sync/' + APPLICANT_ID, { method: 'POST' });
    const j = await r.json();
    if (!r.ok) {
      const c = j.remote?.conflicts || {};
      const extra = Object.values(c).map(x => x.message).join(' · ');
      throw new Error((j.error || j.remote?.error || 'تعذّرت الإضافة') + (extra ? ' — ' + extra : ''));
    }
    location.reload();
  } catch (err) {
    syncBox(err.message, 'bad');
    btn.disabled = false;
  }
}

async function syncAttachments() {
  const btn = document.getElementById('att-sync');
  const box = document.getElementById('att-result');
  if (!confirm('رفع مرفقات هذا الملف إلى سجل الموظف في النظام الأساسي؟')) return;

  btn.disabled = true;
  box.classList.remove('hidden');
  box.style.background = '#eef2f7'; box.style.color = '#43474f';
  box.style.borderRadius = '12px'; box.style.padding = '10px 12px';
  box.textContent = 'جارٍ الرفع…';

  try {
    const r = await fetch('/admin/onboarding/sync-attachments/' + APPLICANT_ID, { method: 'POST' });
    const j = await r.json();
    if (!r.ok && !j.results) throw new Error(j.error || 'تعذّرت المزامنة');

    const rows = (j.results || []).map(x =>
      (x.ok ? '✅ ' : '❌ ') + x.doc
      + (x.duplicate ? ' (مرفوع مسبقاً)' : '')
      + (x.error ? ' — ' + x.error : ''));
    const okAll = (j.results || []).every(x => x.ok);
    box.style.background = okAll ? '#dcfce7' : '#fef3c7';
    box.style.color = okAll ? '#15803d' : '#a16207';
    box.innerHTML = '<b>الموظف #' + j.employee_id + '</b><br>' + rows.join('<br>');
  } catch (err) {
    box.style.background = '#ffdad6'; box.style.color = '#ba1a1a';
    box.textContent = err.message;
  } finally {
    btn.disabled = false;
  }
}

async function saveEmployment(e) {
  e.preventDefault();
  const btn = document.getElementById('emp-save');
  const st = document.getElementById('emp-status');
  const body = Object.fromEntries(new FormData(document.getElementById('emp-form')).entries());
  btn.disabled = true; st.textContent = 'جارٍ الحفظ…'; st.style.color = '#43474f';
  try {
    const r = await fetch('/admin/onboarding/employment/' + APPLICANT_ID, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) {
      // أخطاء الحقول تُعرض عند الحقل نفسه لا في رسالة عامة
      if (j.errors) {
        Object.entries(j.errors).forEach(([k, msg]) => {
          const el = document.getElementById('emp-' + k);
          if (el) { el.style.borderColor = '#ba1a1a'; el.title = msg; }
        });
      }
      throw new Error(j.error || 'تعذّر الحفظ');
    }
    document.querySelectorAll('.emp-in').forEach(el => { el.style.borderColor = ''; el.title = ''; });
    st.textContent = 'تم الحفظ ✓'; st.style.color = '#15803d';

    const box = document.getElementById('emp-missing');
    if (j.missing.length) {
      document.getElementById('emp-missing-list').textContent = j.missing.map(f => f.label).join('، ');
      box.classList.remove('hidden');
    } else {
      box.classList.add('hidden');
    }
  } catch (err) {
    st.textContent = err.message; st.style.color = '#ba1a1a';
  } finally {
    btn.disabled = false;
  }
}

async function obSend(btn) {
  if (!confirm('إرسال رابط استكمال الملف للمرشح عبر واتساب؟')) return;
  const old = btn.innerHTML;
  btn.disabled = true; btn.textContent = 'جارٍ الإرسال…';
  try {
    const r = await fetch('/admin/onboarding/send/' + APPLICANT_ID, { method: 'POST' });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || 'تعذّر الإرسال');
    alert('تم الإرسال إلى ' + (j.sentTo || 'المرشح'));
    location.reload();
  } catch (e) {
    alert(e.message);
    btn.disabled = false; btn.innerHTML = old;
  }
}

async function createLink() {
  const r = await fetch('/admin/onboarding/create/' + APPLICANT_ID, { method: 'POST' });
  const j = await r.json();
  if (!r.ok) return alert(j.error || 'تعذّر إنشاء الرابط');
  location.reload();
}

function copyLink() {
  navigator.clipboard.writeText(document.getElementById('ob-link').textContent.trim())
    .then(() => alert('تم نسخ الرابط'));
}

async function revokeLink(id) {
  if (!confirm('إيقاف الرابط؟ لن يستطيع المرشح فتحه بعدها — وتبقى مستنداته المرفوعة كما هي.')) return;
  const r = await fetch('/admin/onboarding/revoke/' + id, { method: 'POST' });
  if (!r.ok) return alert('تعذّر الإيقاف');
  location.reload();
}

async function review(docId, value) {
  const note = value === 'red' ? (prompt('سبب الرفض (اختياري):') || '') : '';
  const r = await fetch('/admin/onboarding/doc/' + docId + '/review', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ review: value, note }),
  });
  if (!r.ok) return alert('تعذّر الحفظ');
  location.reload();
}
</script>
</body>
</html>
