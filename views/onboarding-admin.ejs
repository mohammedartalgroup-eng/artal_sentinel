<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ملف الاستكمال — <%= applicant.full_name %></title>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"></noscript>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block"></noscript>
  <!--
    تنسيق الصفحة مكتوب هنا لا في tailwind.css المُجمَّع: هذه صفحة تجريبية،
    وإعادة بناء ملف CSS تُحمّله كل صفحات النظام لأجلها مخاطرة بلا داعٍ.
  -->
  <style>
    body{font-family:'Inter',sans-serif;background:#f2f4f6}
    h1,h2,h3{font-family:'Manrope',sans-serif}
    .material-symbols-outlined{font-variation-settings:'FILL' 0,'wght' 400,'GRAD' 0,'opsz' 24}
    .ob-card{background:#fff;border:1px solid #eceef0;border-radius:16px}
    .ob-chip{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;font-weight:600;
             padding:4px 10px;border-radius:99px;white-space:nowrap}
    .g{background:#dcfce7;color:#15803d} .y{background:#fef3c7;color:#a16207}
    .r{background:#ffdad6;color:#ba1a1a} .n{background:#eceef0;color:#43474f}
    .ob-tbl{width:100%;border-collapse:collapse;font-size:13px}
    .ob-tbl th{text-align:right;font-weight:600;color:#43474f;padding:7px 10px;background:#f8f9fb;font-size:12px}
    .ob-tbl td{padding:8px 10px;border-top:1px solid #eceef0;vertical-align:middle}
    .ob-val{font-weight:600;color:#001736;word-break:break-all}
    .ob-src{font-size:11px;color:#747780}
    .ob-btn{display:inline-flex;align-items:center;gap:6px;border:0;border-radius:10px;padding:8px 14px;
            font-size:13px;font-weight:600;cursor:pointer;font-family:inherit}
    .ob-btn.p{background:#001736;color:#fff} .ob-btn.s{background:#eef2f7;color:#001736}
    .ob-btn.d{background:#ffdad6;color:#ba1a1a}
    .ob-link{background:#f8f9fb;border:1px dashed #c4c6d0;border-radius:12px;padding:10px 12px;
             font-size:12.5px;color:#43474f;word-break:break-all;font-family:ui-monospace,monospace}
  </style>
</head>
<body class="text-[#191c1e]">
<%- include('partials/sidebar', { currentPage: 'applicants' }) %>

<div class="lg:mr-64 min-h-screen pt-14 lg:pt-0">
  <header class="bg-white border-b border-[#eceef0] px-4 lg:px-8 py-3 lg:py-4 flex items-center gap-4 sticky top-14 lg:top-0 z-30">
    <a href="/admin/applicants/<%= applicant.id %>" class="text-[#43474f] hover:text-[#001736]">
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <div class="flex-1 min-w-0">
      <h1 class="text-base lg:text-lg font-bold text-[#001736] truncate">ملف الاستكمال — <%= applicant.full_name %></h1>
      <p class="text-xs text-[#43474f]">مستندات وبيانات يرفعها المرشح بنفسه — لا تُكتب في بيانات الطلب إلا بقرارك.</p>
    </div>
    <span class="ob-chip n">تجريبي</span>
  </header>

  <main class="p-4 lg:p-8 max-w-5xl space-y-4">

    <!-- ── محرّك القراءة ─────────────────────────────────────────── -->
    <div class="ob-card p-4 flex flex-wrap items-center gap-3 text-xs text-[#43474f]">
      <span class="font-semibold text-[#001736]">محرّك القراءة:</span>
      <span class="ob-chip <%= engine.ocr ? 'g' : 'n' %>">
        <%= engine.ocr ? 'Google Vision مفعّل' : 'OCR غير مفعّل — إدخال يدوي' %>
      </span>
      <span class="ob-chip <%= engine.ai ? 'g' : 'n' %>">
        <%= engine.ai ? `الذكاء الاصطناعي: ${engine.aiProvider} / ${engine.aiModel}` : 'الذكاء الاصطناعي غير مفعّل' %>
      </span>
      <span class="text-[11px]">النموذج لا يُستدعى إلا حين تعجز القواعد المحلية عن حقل مطلوب.</span>
    </div>

    <% if (!session) { %>
      <!-- ── لا رحلة بعد ──────────────────────────────────────────── -->
      <div class="ob-card p-8 text-center">
        <span class="material-symbols-outlined text-4xl text-[#7594ca]">folder_shared</span>
        <h2 class="text-lg font-bold text-[#001736] mt-3">لم يبدأ هذا المرشح رحلة الاستكمال</h2>
        <p class="text-sm text-[#43474f] mt-2 mb-5">
          أنشئ رابطاً سرياً وأرسله له — يرفع مستنداته من جواله، وتظهر نتائجها هنا.
        </p>
        <button class="ob-btn p" onclick="createLink()">
          <span class="material-symbols-outlined" style="font-size:18px">link</span> إنشاء رابط الاستكمال
        </button>
      </div>
    <% } else { %>
      <!-- ── الرابط والتقدّم ──────────────────────────────────────── -->
      <div class="ob-card p-4 lg:p-5">
        <div class="flex items-center justify-between gap-3 flex-wrap mb-3">
          <div>
            <div class="text-sm font-bold text-[#001736]">رابط المرشح</div>
            <div class="text-xs text-[#43474f]">
              <% if (session.revoked_at) { %>موقوف<% } else if (session.expires_at && new Date(session.expires_at) < new Date()) { %>
                منتهي الصلاحية
              <% } else { %>
                صالح حتى <%= fmtDate(session.expires_at) %> · <%= session.opened_at ? 'فُتح ' + fmtDateTime(session.opened_at) : 'لم يُفتح بعد' %>
              <% } %>
            </div>
          </div>
          <div class="flex gap-2 flex-wrap">
            <button class="ob-btn s" onclick="copyLink()">
              <span class="material-symbols-outlined" style="font-size:18px">content_copy</span> نسخ
            </button>
            <% if (waReady) { %>
            <!-- القالب المعتمد في ميتا — يصل المتقدم حتى خارج نافذة الـ24 ساعة -->
            <button class="ob-btn p" onclick="obSend(this)">
              <span class="material-symbols-outlined" style="font-size:18px">send</span> إرسال بواتساب
            </button>
            <% } %>
            <!-- خطة بديلة دائمة: واتساب يدوي من جوال الموظف (لا يحتاج قالباً) -->
            <a class="ob-btn s" target="_blank" rel="noopener"
               href="https://wa.me/<%= String(applicant.phone||'').replace(/^0/,'966') %>?text=<%= encodeURIComponent(`مرحباً ${String(applicant.full_name||'').split(' ')[0]}،\nلاستكمال ملفك الوظيفي في شركة أرتال، افتح الرابط التالي وارفع المستندات المطلوبة:\n${link}`) %>">
              <span class="material-symbols-outlined" style="font-size:18px">chat</span> واتساب يدوي
            </a>
            <button class="ob-btn d" onclick="revokeLink(<%= session.id %>)">إيقاف الرابط</button>
          </div>
        </div>
        <div class="ob-link" id="ob-link"><%= link %></div>

        <div class="mt-4">
          <div class="flex justify-between text-xs text-[#43474f] mb-1.5">
            <span>التقدّم</span><span><%= session.progress %>%</span>
          </div>
          <div style="height:8px;background:#eceef0;border-radius:99px;overflow:hidden">
            <div style="height:100%;width:<%= session.progress %>%;background:#001736;border-radius:99px"></div>
          </div>
        </div>
      </div>

      <!-- ── المستندات ────────────────────────────────────────────── -->
      <% steps.forEach(function (s) { %>
        <div class="ob-card p-4 lg:p-5">
          <div class="flex items-start justify-between gap-3 flex-wrap">
            <div class="flex items-center gap-3">
              <span class="w-10 h-10 rounded-xl bg-[#eef2f7] text-[#264778] flex items-center justify-center">
                <span class="material-symbols-outlined"><%= s.icon %></span>
              </span>
              <div>
                <div class="font-bold text-[#001736] text-sm"><%= s.label %></div>
                <div class="text-xs text-[#43474f]">
                  <%= s.required ? 'مطلوب' : 'اختياري' %>
                  <% if (s.aiUsed) { %> · <span class="ob-src">استُعين بنموذج لغوي</span><% } %>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
              <% if (!s.hasFile) { %>
                <span class="ob-chip n">لم يُرفع</span>
              <% } else { %>
                <span class="ob-chip <%= s.review === 'green' ? 'g' : (s.review === 'red' ? 'r' : 'y') %>">
                  <%= s.review === 'green' ? 'تم التحقق' : (s.review === 'red' ? 'غير مقبول' : 'يحتاج مراجعة') %>
                </span>
                <% if (s.status === 'confirmed') { %><span class="ob-chip n">أكّده المرشح</span><% } %>
                <a class="ob-btn s" target="_blank" rel="noopener" href="/admin/onboarding/file/<%= s.docId %>">
                  <span class="material-symbols-outlined" style="font-size:18px">visibility</span> المرفق
                </a>
                <!-- يعيد تشغيل القراءة على نفس الملف — لا يمسّ ما صحّحه المرشح بيده -->
                <button class="ob-btn s" onclick="reextract(<%= s.docId %>, this)">
                  <span class="material-symbols-outlined" style="font-size:18px">autorenew</span> إعادة الاستخراج
                </button>
              <% } %>
            </div>
          </div>

          <% if (s.hasFile) { %>
            <% if (s.warnings.length) { %>
              <div class="mt-3 text-xs bg-[#fef3c7] text-[#a16207] rounded-xl px-3 py-2 space-y-1">
                <% s.warnings.forEach(function (w) { %><div>⚠️ <%= w %></div><% }) %>
              </div>
            <% } %>

            <div class="mt-3 overflow-x-auto">
              <table class="ob-tbl">
                <thead><tr><th>الحقل</th><th>القيمة</th><th>المصدر</th><th>القيمة كما قُرئت</th></tr></thead>
                <tbody>
                <% s.fields.forEach(function (f) { %>
                  <tr>
                    <td class="text-[#43474f] whitespace-nowrap"><%= f.label %><%= f.required ? ' *' : '' %></td>
                    <td class="ob-val">
                      <%= f.value || '—' %>
                      <% if (f.value && f.valid === false) { %>
                        <div class="ob-chip r mt-1"><%= f.error || 'غير صالح' %></div>
                      <% } %>
                    </td>
                    <td class="ob-src">
                      <%= { ocr:'قراءة آلية', ai:'نموذج لغوي', user:'أدخله المرشح', rule:'قاعدة النظام' }[f.source] || '—' %>
                      <% if (f.confidence) { %><br><%= Math.round(f.confidence * 100) %>%<% } %>
                    </td>
                    <td class="ob-src"><%= f.raw && f.raw !== f.value ? f.raw : '—' %></td>
                  </tr>
                <% }) %>
                </tbody>
              </table>
            </div>

            <!-- قرار HR — الاستثناءات وحدها تصل إلى إنسان -->
            <div class="mt-3 flex items-center gap-2 flex-wrap">
              <span class="text-xs text-[#43474f]">قرارك:</span>
              <button class="ob-btn s" onclick="review(<%= s.docId %>,'green')">مقبول</button>
              <button class="ob-btn s" onclick="review(<%= s.docId %>,'yellow')">يحتاج مراجعة</button>
              <button class="ob-btn d" onclick="review(<%= s.docId %>,'red')">غير مقبول</button>
              <% if (s.hrNote) { %><span class="ob-src">— <%= s.hrNote %></span><% } %>
            </div>
          <% } %>
        </div>
      <% }) %>

      <% if (history.length) { %>
        <div class="ob-card p-4 lg:p-5">
          <div class="text-sm font-bold text-[#001736] mb-2">نسخ سابقة (سجل تدقيق)</div>
          <div class="text-xs text-[#43474f] mb-3">مستندات استُبدلت بإعادة رفع — محفوظة ولا تُحتسب.</div>
          <table class="ob-tbl">
            <tbody>
            <% history.forEach(function (h) { %>
              <tr>
                <td class="whitespace-nowrap"><%= DOC_TYPES[h.doc_type] ? DOC_TYPES[h.doc_type].label : h.doc_type %></td>
                <td class="ob-src"><%= fmtDateTime(h.created_at) %></td>
                <td><a class="text-[#405f91] underline" target="_blank" rel="noopener" href="/admin/onboarding/file/<%= h.id %>">عرض</a></td>
              </tr>
            <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    <% } %>
  </main>
</div>

<script>
const APPLICANT_ID = <%= applicant.id %>;

async function reextract(docId, btn) {
  if (!confirm('إعادة قراءة المستند بالقواعد الحالية؟\nالقيم التي صحّحها المرشح بنفسه لن تتغيّر.')) return;
  const old = btn.innerHTML;
  btn.disabled = true; btn.textContent = 'جارٍ القراءة…';
  try {
    const r = await fetch('/admin/onboarding/doc/' + docId + '/reextract', { method: 'POST' });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || 'تعذّرت إعادة الاستخراج');
    if (!j.changed.length) {
      alert('لا جديد — القيم الحالية مطابقة لما تقرؤه القواعد الآن.'
        + (j.ocrError ? '\n\nتنبيه: ' + j.ocrError : ''));
      btn.disabled = false; btn.innerHTML = old;
      return;
    }
    alert('تحدّث ' + j.changed.length + ' حقل:\n\n'
      + j.changed.map(c => '• ' + c.label + ': ' + (c.from || '—') + '  ←  ' + c.to).join('\n'));
    location.reload();
  } catch (e) {
    alert(e.message);
    btn.disabled = false; btn.innerHTML = old;
  }
}

async function obSend(btn) {
  if (!confirm('إرسال رابط استكمال الملف للمرشح عبر واتساب؟')) return;
  const old = btn.innerHTML;
  btn.disabled = true; btn.textContent = 'جارٍ الإرسال…';
  try {
    const r = await fetch('/admin/onboarding/send/' + APPLICANT_ID, { method: 'POST' });
    const j = await r.json().catch(() => ({}));
    if (!r.ok) throw new Error(j.error || 'تعذّر الإرسال');
    alert('تم الإرسال إلى ' + (j.sentTo || 'المرشح'));
    location.reload();
  } catch (e) {
    alert(e.message);
    btn.disabled = false; btn.innerHTML = old;
  }
}

async function createLink() {
  const r = await fetch('/admin/onboarding/create/' + APPLICANT_ID, { method: 'POST' });
  const j = await r.json();
  if (!r.ok) return alert(j.error || 'تعذّر إنشاء الرابط');
  location.reload();
}

function copyLink() {
  navigator.clipboard.writeText(document.getElementById('ob-link').textContent.trim())
    .then(() => alert('تم نسخ الرابط'));
}

async function revokeLink(id) {
  if (!confirm('إيقاف الرابط؟ لن يستطيع المرشح فتحه بعدها — وتبقى مستنداته المرفوعة كما هي.')) return;
  const r = await fetch('/admin/onboarding/revoke/' + id, { method: 'POST' });
  if (!r.ok) return alert('تعذّر الإيقاف');
  location.reload();
}

async function review(docId, value) {
  const note = value === 'red' ? (prompt('سبب الرفض (اختياري):') || '') : '';
  const r = await fetch('/admin/onboarding/doc/' + docId + '/review', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ review: value, note }),
  });
  if (!r.ok) return alert('تعذّر الحفظ');
  location.reload();
}
</script>
</body>
</html>
