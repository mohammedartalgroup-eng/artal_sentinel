<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= applicant.full_name %> — أرتال Sentinel</title>
  <link rel="icon" type="image/png" href="/images/icon.png">
  <link rel="stylesheet" href="/css/tailwind.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"></noscript>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block" onload="this.onload=null;this.rel='stylesheet'"><noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=block"></noscript>
  <style>
    body { font-family: 'Inter', sans-serif; background: #f2f4f6; }
    h1,h2,h3 { font-family: 'Manrope', sans-serif; }
    .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
    .star-btn { cursor: pointer; font-size: 1.5rem; transition: color 0.15s; }
    .star-btn.active { color: #e2c382; }
    .star-btn:not(.active) { color: #c4c6d0; }
    .star-btn:hover, .star-btn:hover ~ .star-btn { color: #e2c382; }

    /* ─── Print ──────────────────────────────────────── */
    #print-doc { display: none; }
    @media print {
      body > *                { display: none !important; }
      #print-doc              { display: block !important; }
      @page                   { size: A4; margin: 15mm 18mm; }

      /* reset */
      * { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

      .pd-page-break          { page-break-before: always; }
      .pd-avoid-break         { page-break-inside: avoid; }
    }
  </style>
</head>
<body class="text-[#191c1e]">
<%- include('partials/sidebar', { currentPage: 'applicants' }) %>

<%
const colorMap = {
  blue:'bg-blue-100 text-blue-700', yellow:'bg-yellow-100 text-yellow-800',
  purple:'bg-purple-100 text-purple-700', orange:'bg-orange-100 text-orange-700',
  green:'bg-green-100 text-green-700', gray:'bg-gray-100 text-gray-600',
  red:'bg-red-100 text-red-700'
};
const sm = STATUS_META[applicant.status] || { label: applicant.status, color: 'gray' };
%>

<div class="lg:mr-64 min-h-screen pt-14 lg:pt-0">
  <!-- Top bar -->
  <header class="bg-white border-b border-[#eceef0] px-4 lg:px-8 py-3 lg:py-4 flex items-center gap-4 sticky top-14 lg:top-0 z-30">
    <a href="/admin/applicants" class="text-[#43474f] hover:text-[#001736] transition-colors">
      <span class="material-symbols-outlined">arrow_forward</span>
    </a>
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2 flex-wrap">
        <h1 class="text-base lg:text-lg font-bold text-[#001736] truncate"><%= applicant.full_name %></h1>
        <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= colorMap[sm.color] %>">
          <%= sm.label %>
        </span>
        <!-- Star rating display -->
        <div class="flex items-center gap-0.5" id="ratingDisplay">
          <% for (let i = 1; i <= 5; i++) { %>
          <button class="star-btn <%= i <= applicant.rating ? 'active' : '' %>"
                  data-value="<%= i %>" onclick="setRating(<%= i %>)" title="<%= i %> نجوم">★</button>
          <% } %>
        </div>
      </div>
      <p class="text-xs text-[#43474f] mt-0.5">
        تقديم رقم #<%= applicant.id %> —
        <%= fmtDateLong(applicant.created_at) %>
      </p>
    </div>
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <!-- Audit log button -->
      <a href="/admin/audit?applicant_id=<%= applicant.id %>"
         class="flex items-center gap-1.5 px-2.5 sm:px-4 py-2 rounded-xl text-[#405f91] bg-[#f2f4f6] hover:bg-[#e8ecf4] text-sm font-medium transition-colors">
        <span class="material-symbols-outlined text-base">manage_search</span>
        <span class="hidden sm:inline">سجل التدقيق</span>
      </a>
      <!-- Print button -->
      <button onclick="window.print()"
              class="flex items-center gap-1.5 px-2.5 sm:px-4 py-2 rounded-xl text-[#405f91] bg-[#f2f4f6] hover:bg-[#e8ecf4] text-sm font-medium transition-colors">
        <span class="material-symbols-outlined text-base">print</span>
        <span class="hidden sm:inline">طباعة</span>
      </button>
      <!-- Delete button — للمديرين فقط -->
      <% if (locals.adminRole === 'manager') { %>
      <button onclick="deleteApplicant()"
              class="flex items-center gap-1.5 px-2.5 sm:px-4 py-2 rounded-xl text-red-600 bg-red-50 hover:bg-red-100 text-sm font-medium transition-colors">
        <span class="material-symbols-outlined text-base">delete</span>
        <span class="hidden sm:inline">حذف</span>
      </button>
      <% } %>
    </div>
  </header>

  <!-- Status Pipeline -->
  <div class="bg-white border-b border-[#eceef0] px-4 lg:px-8 py-3 lg:py-4">
    <div class="flex items-center gap-1.5 lg:gap-2 flex-wrap">
      <% const pipeline = ['pending','reviewed','shortlisted','interviewed','hired']; %>
      <% const pipelinePos = pipeline.indexOf(applicant.status); %>
      <% pipeline.forEach((step, i) => { %>
      <%
        let btnClass = 'border border-[#e0e3e5] text-[#43474f] bg-white hover:bg-[#f2f4f6]';
        if (step === applicant.status) btnClass = 'bg-[#001736] text-white border-[#001736]';
        else if (i < pipelinePos) btnClass = 'bg-[#f2f4f6] text-[#43474f] border-[#e0e3e5]';
      %>
      <button onclick="updateStatus('<%= step %>')"
              class="px-4 py-2 rounded-xl text-xs font-semibold transition-all <%= btnClass %>">
        <%= STATUS_META[step].label %>
      </button>
      <% if (i < pipeline.length - 1) { %>
      <span class="text-[#c4c6d0] material-symbols-outlined text-sm">chevron_left</span>
      <% } %>
      <% }) %>
      <span class="mx-2 text-[#c4c6d0]">|</span>
      <button onclick="updateStatus('on_hold')"
              class="px-4 py-2 rounded-xl text-xs font-semibold border transition-all
                     <%= applicant.status === 'on_hold' ? 'bg-gray-500 text-white border-gray-500' : 'border-[#e0e3e5] text-[#43474f] hover:bg-[#f2f4f6]' %>">
        احتياطي
      </button>
      <button onclick="updateStatus('rejected')"
              class="px-4 py-2 rounded-xl text-xs font-semibold border transition-all
                     <%= applicant.status === 'rejected' ? 'bg-red-600 text-white border-red-600' : 'border-[#e0e3e5] text-red-600 hover:bg-red-50' %>">
        مرفوض
      </button>
    </div>
  </div>

  <main class="p-4 lg:p-8">

    <!-- تقديمات سابقة بنفس رقم الهوية (نظرة على تاريخ المرشّح) -->
    <% if (typeof priorApps !== 'undefined' && priorApps && priorApps.length) { %>
    <%
      const _badgeColor = { blue:'bg-blue-100 text-blue-700', yellow:'bg-yellow-100 text-yellow-700', purple:'bg-purple-100 text-purple-700', orange:'bg-orange-100 text-orange-700', green:'bg-green-100 text-green-700', gray:'bg-gray-100 text-gray-600', red:'bg-red-100 text-red-700' };
      const _fmtDate = (v) => { const d = new Date(v); return isNaN(d) ? v : d.toLocaleDateString('ar-SA', { timeZone:'Asia/Riyadh', year:'numeric', month:'short', day:'numeric' }); };
    %>
    <div class="mb-6 bg-amber-50 border border-amber-200 rounded-2xl p-5">
      <div class="flex items-center gap-2 mb-3">
        <span class="material-symbols-outlined text-amber-600">history</span>
        <h2 class="font-bold text-[#001736] text-sm">سجّل هذا الشخص من قبل — <%= priorApps.length %> تقديم سابق بنفس رقم الهوية</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-2">
        <% priorApps.forEach(pa => { const psm = STATUS_META[pa.status] || { label: pa.status, color: 'gray' }; %>
        <a href="/admin/applicants/<%= pa.id %>" class="flex items-center justify-between gap-3 bg-white border border-amber-100 rounded-xl px-4 py-2.5 hover:border-amber-300 transition">
          <span class="text-sm text-[#43474f] flex items-center gap-1">
            <span class="material-symbols-outlined text-sm">calendar_month</span><%= _fmtDate(pa.created_at) %>
          </span>
          <span class="flex items-center gap-2">
            <span class="text-xs px-2 py-0.5 rounded-full font-semibold <%= _badgeColor[psm.color] || _badgeColor.gray %>"><%= psm.label %></span>
            <span class="material-symbols-outlined text-sm text-amber-500">open_in_new</span>
          </span>
        </a>
        <% }) %>
      </div>
      <p class="text-xs text-amber-700 mt-3">تقديمات أخرى بنفس رقم الهوية — لاطّلاعك على تاريخ المرشّح مع الشركة.</p>
    </div>
    <% } %>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

      <!-- LEFT: Info + Docs -->
      <div class="lg:col-span-1 space-y-6">

        <!-- Personal Info -->
        <div class="bg-white rounded-2xl p-6">
          <h2 class="font-bold text-[#001736] text-sm mb-5 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">assignment_ind</span>
            البيانات الشخصية
          </h2>
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">person</span>
              <div>
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">الاسم الرباعي</div>
                <div class="font-medium mt-0.5"><%= applicant.full_name %></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">badge</span>
              <div>
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">رقم الهوية</div>
                <div class="font-mono mt-0.5"><%= applicant.id_number %></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">smartphone</span>
              <div>
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">رقم الجوال</div>
                <div class="mt-0.5" dir="ltr"><%= applicant.phone %></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">mail</span>
              <div class="min-w-0">
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">البريد الإلكتروني</div>
                <% if (applicant.email) { %>
                <a href="mailto:<%= applicant.email %>" class="mt-0.5 block text-[#7594ca] hover:underline break-all" dir="ltr"><%= applicant.email %></a>
                <% } else { %>
                <div class="mt-0.5 text-[#8a8f98]">—</div>
                <% } %>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">cake</span>
              <div>
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">العمر</div>
                <div class="mt-0.5"><%= applicant.age ? applicant.age + ' سنة' : '—' %></div>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">location_on</span>
              <div>
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">مقر السكن</div>
                <% if (applicant.region) { %>
                <div class="text-xs text-[#7594ca] font-medium mt-0.5"><%= applicant.region %></div>
                <% } %>
                <div class="mt-0.5"><%= applicant.city || '—' %></div>
                <% if (applicant.neighborhood) { %>
                <div class="text-xs text-[#43474f] mt-0.5">حي <%= applicant.neighborhood %></div>
                <% } %>
              </div>
            </div>
            <% if (applicant.source) { %>
            <div class="flex items-start gap-3">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">travel_explore</span>
              <div class="min-w-0">
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">مصدر التقديم</div>
                <div class="mt-0.5 font-medium"><%= applicant.source %></div>
                <% if (applicant.landing_page) { %>
                <div class="text-xs text-[#7594ca] mt-0.5 break-all" dir="ltr">صفحة الدخول: <%= applicant.landing_page %></div>
                <% } %>
                <% if (applicant.referrer) { %>
                <div class="text-xs text-[#43474f] mt-0.5 break-all" dir="ltr" title="<%= applicant.referrer %>">من: <%= applicant.referrer.length > 70 ? applicant.referrer.slice(0,70) + '…' : applicant.referrer %></div>
                <% } %>
              </div>
            </div>
            <% } %>
            <%
              const QUAL_LABELS = { none:'بدون مؤهل', primary:'ابتدائي', middle:'متوسط', high_school:'ثانوي', university:'جامعي' };
            %>
            <% if (applicant.qualification) { %>
            <div class="flex items-start gap-3 pt-1">
              <span class="material-symbols-outlined text-[#43474f] text-lg mt-0.5">school</span>
              <div>
                <div class="text-xs text-[#43474f] font-semibold uppercase tracking-wider">المؤهل العلمي</div>
                <div class="mt-0.5 font-medium"><%= QUAL_LABELS[applicant.qualification] || applicant.qualification %></div>
                <% if (applicant.specialization) { %>
                <div class="text-xs text-[#7594ca] mt-0.5">تخصص: <%= applicant.specialization %></div>
                <% } %>
              </div>
            </div>
            <% } %>

            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="bg-[#f8f9fb] rounded-xl p-3 text-center">
                <span class="material-symbols-outlined text-2xl <%= applicant.gender === 'male' ? 'text-blue-500' : applicant.gender === 'female' ? 'text-pink-500' : 'text-[#c4c6d0]' %>">
                  <%= applicant.gender === 'female' ? 'female' : 'male' %>
                </span>
                <div class="text-xs text-[#43474f] mt-1">الجنس</div>
                <div class="text-sm font-semibold <%= applicant.gender === 'male' ? 'text-blue-600' : applicant.gender === 'female' ? 'text-pink-600' : 'text-[#43474f]' %>">
                  <%= applicant.gender === 'male' ? 'ذكر' : applicant.gender === 'female' ? 'أنثى' : '—' %>
                </div>
              </div>
              <div class="bg-[#f8f9fb] rounded-xl p-3 text-center">
                <span class="material-symbols-outlined text-2xl <%= applicant.has_car ? 'text-green-600' : 'text-[#c4c6d0]' %>">
                  directions_car
                </span>
                <div class="text-xs text-[#43474f] mt-1">سيارة</div>
                <div class="text-sm font-semibold <%= applicant.has_car ? 'text-green-700' : 'text-[#43474f]' %>">
                  <%= applicant.has_car ? 'نعم' : 'لا' %>
                </div>
              </div>
              <div class="bg-[#f8f9fb] rounded-xl p-3 text-center">
                <span class="material-symbols-outlined text-2xl <%= applicant.has_license ? 'text-green-600' : 'text-[#c4c6d0]' %>">
                  card_membership
                </span>
                <div class="text-xs text-[#43474f] mt-1">رخصة</div>
                <div class="text-sm font-semibold <%= applicant.has_license ? 'text-green-700' : 'text-[#43474f]' %>">
                  <%= applicant.has_license ? 'نعم' : 'لا' %>
                </div>
              </div>
              <% if (applicant.english != null) { %>
              <div class="bg-[#f8f9fb] rounded-xl p-3 text-center">
                <span class="material-symbols-outlined text-2xl <%= applicant.english ? 'text-blue-500' : 'text-[#c4c6d0]' %>">
                  translate
                </span>
                <div class="text-xs text-[#43474f] mt-1">إنجليزية</div>
                <div class="text-sm font-semibold <%= applicant.english ? 'text-blue-600' : 'text-[#43474f]' %>">
                  <%= applicant.english ? 'نعم' : 'لا' %>
                </div>
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Documents -->
        <div class="bg-white rounded-2xl p-6">
          <h2 class="font-bold text-[#001736] text-sm mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">folder_open</span>
            المرفقات
          </h2>
          <div class="space-y-3">
            <% if (applicant.cv_path) { %>
            <a href="/admin/files/cv/<%= applicant.cv_path %>" target="_blank"
               class="flex items-center gap-3 p-3 bg-[#f8f9fb] rounded-xl hover:bg-[#f2f4f6] transition-colors group">
              <div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-red-600 text-lg">description</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-[#001736] truncate">السيرة الذاتية</div>
                <div class="text-xs text-[#43474f]">CV</div>
              </div>
              <span class="material-symbols-outlined text-[#405f91] text-lg group-hover:scale-110 transition-transform">
                open_in_new
              </span>
            </a>
            <% } else { %>
            <div class="flex items-center gap-3 p-3 bg-[#f8f9fb] rounded-xl opacity-50">
              <div class="w-10 h-10 rounded-lg bg-[#eceef0] flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[#c4c6d0] text-lg">description</span>
              </div>
              <div class="text-sm text-[#43474f]">لم يرفع السيرة الذاتية</div>
            </div>
            <% } %>

            <% if (applicant.id_image_path) { %>
            <a href="/admin/files/id_images/<%= applicant.id_image_path %>" target="_blank"
               class="flex items-center gap-3 p-3 bg-[#f8f9fb] rounded-xl hover:bg-[#f2f4f6] transition-colors group">
              <div class="w-10 h-10 rounded-lg bg-blue-100 flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-blue-600 text-lg">badge</span>
              </div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-[#001736]">صورة الهوية</div>
                <div class="text-xs text-[#43474f]">ID Image</div>
              </div>
              <span class="material-symbols-outlined text-[#405f91] text-lg group-hover:scale-110 transition-transform">
                open_in_new
              </span>
            </a>
            <% } else { %>
            <div class="flex items-center gap-3 p-3 bg-[#f8f9fb] rounded-xl opacity-50">
              <div class="w-10 h-10 rounded-lg bg-[#eceef0] flex items-center justify-center flex-shrink-0">
                <span class="material-symbols-outlined text-[#c4c6d0] text-lg">badge</span>
              </div>
              <div class="text-sm text-[#43474f]">لم يرفع صورة الهوية</div>
            </div>
            <% } %>
          </div>
        </div>

        <!-- External System Check -->
        <div class="bg-white rounded-2xl p-6" id="ext-check-card">
          <h2 class="font-bold text-[#001736] text-sm mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">manage_search</span>
            سجل التوظيف السابق
          </h2>

          <% if (!applicant.ext_check_done) { %>
          <!-- لم يُفحص بعد — سيُطلق JS الفحص تلقائياً -->
          <div id="ext-pending" class="flex items-center gap-2 text-sm text-[#43474f]">
            <span class="material-symbols-outlined text-base text-[#7594ca] animate-spin" id="ext-spinner">autorenew</span>
            <span id="ext-pending-text">جاري التحقق...</span>
          </div>
          <div id="ext-result-box" class="hidden mt-3"></div>
          <!-- زر يدوي في حال فشل التحقق التلقائي -->
          <div class="mt-3 pt-3 border-t border-[#f2f4f6]">
            <button onclick="extRecheck()"
                    class="text-[10px] text-[#405f91] hover:underline flex items-center gap-0.5">
              <span class="material-symbols-outlined text-[12px]">refresh</span>
              فحص يدوي
            </button>
          </div>

          <% } else if (applicant.ext_found) { %>
          <%
            const extActive = applicant.ext_status == 1 && applicant.ext_job_status === 'active';
          %>
          <div class="space-y-3" id="ext-found-box">
            <div class="flex items-center gap-2">
              <span class="material-symbols-outlined text-lg <%= extActive ? 'text-green-600' : 'text-orange-500' %>"
                    style="font-variation-settings:'FILL' 1">
                <%= extActive ? 'verified_user' : 'history' %>
              </span>
              <span class="text-sm font-semibold <%= extActive ? 'text-green-700' : 'text-orange-600' %>">
                <%= extActive ? 'موظف حالي نشط' : 'موظف سابق — منتهي الخدمة' %>
              </span>
            </div>
            <div class="bg-[#f8f9fb] rounded-xl p-3 text-xs text-[#43474f] space-y-1.5">
              <div class="flex justify-between">
                <span class="text-[#9ca3af]">رقم الموظف</span>
                <strong class="text-[#001736]">#<%= applicant.ext_employee_id %></strong>
              </div>
              <div class="flex justify-between">
                <span class="text-[#9ca3af]">حالة الوظيفة</span>
                <strong><%= applicant.ext_job_status || '—' %></strong>
              </div>
            </div>
            <a href="https://artalsys.com/admin/employee-management/employees/<%= applicant.ext_employee_id %>/view"
               target="_blank" rel="noopener"
               class="flex items-center justify-center gap-1.5 w-full text-xs font-semibold
                      text-[#405f91] bg-[#eef2fa] hover:bg-[#dce6f7] px-3 py-2.5 rounded-xl transition-colors">
              <span class="material-symbols-outlined text-sm">open_in_new</span>
              عرض ملف الموظف في النظام السابق
            </a>
          </div>

          <% } else { %>
          <div class="flex items-center gap-2 text-sm text-[#6b7280]">
            <span class="material-symbols-outlined text-base text-[#c4c6d0]">person_off</span>
            <span>غير مسجل في النظام السابق</span>
          </div>
          <% } %>

          <!-- تذييل: تاريخ الفحص + زر إعادة الفحص -->
          <% if (applicant.ext_check_done) { %>
          <div class="mt-4 pt-3 border-t border-[#f2f4f6] flex items-center justify-between">
            <span class="text-[10px] text-[#9ca3af]">
              فُحص بتاريخ: <%= fmtDate(applicant.ext_checked_at) %>
            </span>
            <button onclick="extRecheck()"
                    class="text-[10px] text-[#405f91] hover:underline flex items-center gap-0.5">
              <span class="material-symbols-outlined text-[12px]">refresh</span>
              إعادة الفحص
            </button>
          </div>
          <% } %>
        </div>

      </div>

      <!-- RIGHT: CRM Timeline + Notes -->
      <div class="lg:col-span-2 space-y-6">

        <!-- ═══ المقابلة الأونلاين ═══ -->
        <!-- تظهر فقط إذا كانت الميزة مفعّلة ومخططها جاهز — وأي خطأ في بنائها
             يُلغي البطاقة وحدها (الخادم يمرر activeInterview = null) -->
        <% if (typeof interviewsEnabled !== 'undefined' && interviewsEnabled) { %>
        <div class="bg-white rounded-2xl p-6" id="interview-card">
          <h2 class="font-bold text-[#001736] text-sm mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">video_call</span>
            المقابلة الأونلاين
          </h2>

          <% const IV = (typeof activeInterview !== 'undefined') ? activeInterview : null; %>
          <% const WT = (typeof waTemplates !== 'undefined' && waTemplates) ? waTemplates : { list: [], fields: {}, defaults: {} }; %>
          <% const WT_ON = WT.list.length && applicant.phone; %>
          <% if (!IV) { %>
            <% if (!googleConnected) { %>
            <div class="bg-[#f8f9fb] border border-[#e0e3e5] rounded-xl px-4 py-3.5 text-xs text-[#43474f] flex items-start gap-2">
              <span class="material-symbols-outlined text-base">info</span>
              <span>
                لم يُربط حساب Google بعد، فالجدولة غير متاحة.
                <% if (locals.adminRole === 'manager') { %>
                <a href="/admin/settings#google" class="text-[#405f91] font-semibold" style="text-decoration:underline;">اربط الحساب من الإعدادات</a>.
                <% } else { %>راجع مدير النظام.<% } %>
              </span>
            </div>
            <% } else { %>
            <div class="flex items-center justify-between gap-4 flex-wrap">
              <p class="text-xs text-[#43474f]">حدّد موعداً متاحاً وسيُنشأ اجتماع Google Meet تلقائياً.</p>
              <div class="flex items-center gap-2 flex-wrap">
                <% if (WT_ON) { WT.list.forEach(function (t) { %>
                <button type="button" onclick="openWaTemplate('<%= t.key %>')"
                        class="text-sm font-semibold px-4 py-2.5 rounded-xl border border-[#e0e3e5] text-[#43474f] hover:bg-[#f8f9fb] transition-colors flex items-center gap-2">
                  <span class="material-symbols-outlined text-base text-[#25D366]"><%= t.icon %></span>
                  <%= t.label %>
                </button>
                <% }); } %>
                <button type="button" onclick="openInterviewModal()"
                        class="bg-[#001736] text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-[#002b5b] transition-colors flex items-center gap-2">
                  <span class="material-symbols-outlined text-base">event</span>
                  جدولة مقابلة
                </button>
              </div>
            </div>
            <% } %>
          <% } else { %>
            <% if (IV.status === 'pending') { %>
            <div class="bg-amber-50 border border-amber-200 text-amber-800 rounded-xl px-4 py-3 text-xs mb-4 flex items-start gap-2">
              <span class="material-symbols-outlined text-base">warning</span>
              <span>لم يكتمل إنشاء هذه المقابلة في تقويم Google — راجعها من <a href="/admin/interviews?status=pending" class="font-semibold" style="text-decoration:underline;">صفحة المقابلات</a>.</span>
            </div>
            <% } %>
            <div class="bg-[#f8f9fb] rounded-xl p-4 space-y-3">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="material-symbols-outlined text-base text-[#405f91]">calendar_month</span>
                <span class="text-sm font-bold text-[#001736]"><%= IV.dateLabel %></span>
                <span class="text-sm text-[#43474f]">— الساعة <span dir="ltr"><%= IV.timeLabel %></span></span>
                <span class="text-[11px] text-[#43474f] bg-white border border-[#e0e3e5] rounded-full px-2 py-0.5"><%= IV.durationMin %> دقيقة</span>
              </div>

              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-[11px] text-[#43474f]">المقابلون:</span>
                <% IV.interviewers.forEach(function (p) { %>
                <span class="bg-[#eef2fa] text-[#405f91] rounded-full px-2 py-0.5 text-[11px] font-semibold"><%= p.name %></span>
                <% }); %>
              </div>

              <% if (IV.meetLink) { %>
              <div class="flex items-center gap-2 bg-white border border-[#e0e3e5] rounded-xl px-3 py-2">
                <span class="material-symbols-outlined text-base text-[#405f91]">link</span>
                <span dir="ltr" class="font-mono text-xs text-[#001736] truncate flex-1" id="meet-link-text"><%= IV.meetLink %></span>
                <button type="button" onclick="copyMeetLink()" title="نسخ الرابط"
                        class="text-[#43474f] hover:text-[#001736] transition-colors">
                  <span class="material-symbols-outlined text-base">content_copy</span>
                </button>
              </div>
              <% } else { %>
              <div class="flex items-center gap-2 bg-white border border-[#e0e3e5] rounded-xl px-3 py-2">
                <span class="text-xs text-[#43474f] flex-1">الرابط قيد الإنشاء لدى Google…</span>
                <button type="button" onclick="refreshMeetLink()"
                        class="text-xs font-semibold text-[#405f91] hover:underline">تحديث الرابط</button>
              </div>
              <% } %>

              <div class="flex gap-2 flex-wrap pt-1">
                <% if (IV.meetLink) { %>
                <a href="<%= IV.meetLink %>" target="_blank" rel="noopener"
                   class="text-xs font-semibold px-3 py-2 rounded-xl bg-[#001736] text-white hover:bg-[#002b5b] transition-colors flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm">videocam</span>
                  فتح الاجتماع
                </a>
                <% } %>
                <% if (typeof waUrl !== 'undefined' && waUrl) { %>
                <a href="<%= waUrl %>" target="_blank" rel="noopener"
                   class="text-xs font-semibold px-3 py-2 rounded-xl border border-[#e0e3e5] text-[#43474f] hover:bg-white transition-colors flex items-center gap-1.5">
                  <svg viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5 text-[#25D366]">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  إرسال واتساب
                </a>
                <% } %>
                <% if (IV.htmlLink) { %>
                <a href="<%= IV.htmlLink %>" target="_blank" rel="noopener"
                   class="text-xs font-semibold px-3 py-2 rounded-xl border border-[#e0e3e5] text-[#43474f] hover:bg-white transition-colors flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm">calendar_month</span>
                  تقويم Google
                </a>
                <% } %>
                <button type="button" onclick="openInterviewModal(true)"
                        class="text-xs font-semibold px-3 py-2 rounded-xl border border-[#e0e3e5] text-[#43474f] hover:bg-white transition-colors flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm">edit_calendar</span>
                  إعادة الجدولة
                </button>
                <button type="button" onclick="cancelInterview()"
                        class="text-xs font-semibold px-3 py-2 rounded-xl border border-red-200 text-red-600 hover:bg-red-50 transition-colors flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm">event_busy</span>
                  إلغاء المقابلة
                </button>
                <% if (WT_ON) { WT.list.forEach(function (t) { %>
                <button type="button" onclick="openWaTemplate('<%= t.key %>')"
                        class="text-xs font-semibold px-3 py-2 rounded-xl border border-[#e0e3e5] text-[#43474f] hover:bg-white transition-colors flex items-center gap-1.5">
                  <span class="material-symbols-outlined text-sm"><%= t.icon %></span>
                  <%= t.label %>
                </button>
                <% }); } %>
              </div>

              <!-- حالة إشعار المتقدم — الفشل الصامت هنا يعني متقدماً لا يعرف موعده -->
              <%
                const DLV = (typeof delivery !== 'undefined' && delivery) ? delivery : {};
                const NCH = (typeof notifyChannels !== 'undefined' && notifyChannels) ? notifyChannels : {};
                const CHAN = [
                  { key: 'whatsapp', label: 'واتساب', icon: 'chat', has: Boolean(applicant.phone) },
                  { key: 'email',    label: 'البريد', icon: 'mail', has: Boolean(applicant.email) },
                ];
                const CHIP = {
                  sent:    { cls: 'bg-green-50 text-green-700 border-green-200', icon: 'check_circle', text: 'أُرسل' },
                  failed:  { cls: 'bg-red-50 text-red-600 border-red-200',       icon: 'error',        text: 'فشل' },
                  skipped: { cls: 'bg-[#f2f4f6] text-[#43474f] border-[#e0e3e5]', icon: 'remove',      text: 'لم يُرسل' },
                };
              %>
              <div class="border-t border-[#e0e3e5] pt-3 mt-1" id="iv-delivery">
                <div class="text-[11px] font-semibold text-[#43474f] mb-2">إشعار المتقدم</div>
                <div class="flex flex-wrap items-center gap-2">
                  <% CHAN.forEach(function (c) {
                       const rec = DLV[c.key];
                       const st  = rec ? (CHIP[rec.status] || CHIP.skipped) : null;
                       const why = rec && rec.error ? rec.error : (!c.has ? (c.key === 'email' ? 'لا يوجد بريد مسجّل للمتقدم' : 'لا يوجد رقم جوال') : 'لم تُجرَّب هذه القناة بعد');
                  %>
                  <span class="inline-flex items-center gap-1.5 border rounded-full px-2.5 py-1 text-[11px] font-semibold
                               <%= st ? st.cls : 'bg-[#f2f4f6] text-[#43474f] border-[#e0e3e5]' %>"
                        title="<%= why %>">
                    <span class="material-symbols-outlined text-[13px]"><%= c.icon %></span>
                    <%= c.label %>
                    <span class="opacity-70">·</span>
                    <%= st ? st.text : 'لم يُرسل' %>
                  </span>
                  <% }); %>

                  <% if (NCH.whatsapp || NCH.email) { %>
                  <button type="button" onclick="resendNotify()" id="iv-resend"
                          class="text-[11px] font-semibold px-2.5 py-1 rounded-full border border-[#e0e3e5] text-[#405f91] hover:bg-white transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[13px]">send</span>
                    إعادة الإرسال
                  </button>
                  <% } %>
                </div>

                <%
                  // الأسباب كنص ظاهر: التلميح (title) لا يُعرض باللمس على الجوال،
                  // وسبب عدم الوصول هو أهم معلومة في هذه البطاقة.
                  const PROBLEMS = CHAN
                    .map(c => ({ c, rec: DLV[c.key] }))
                    .filter(x => x.rec && x.rec.status !== 'sent' && x.rec.error);
                %>
                <% if (PROBLEMS.length) { %>
                <div class="mt-2 space-y-1">
                  <% PROBLEMS.forEach(function (x) { %>
                  <div class="flex items-start gap-1.5 text-[11px] <%= x.rec.status === 'failed' ? 'text-red-600' : 'text-[#43474f]' %>">
                    <span class="material-symbols-outlined text-[13px] mt-px"><%= x.rec.status === 'failed' ? 'error' : 'info' %></span>
                    <span><span class="font-semibold"><%= x.c.label %>:</span> <%= x.rec.error %></span>
                  </div>
                  <% }); %>
                </div>
                <% } %>
                <% if (!NCH.whatsapp && !NCH.email) { %>
                <p class="text-[10px] text-[#7594ca] mt-2">
                  الإرسال التلقائي غير مفعّل —
                  <% if (locals.adminRole === 'manager') { %>
                  <a href="/admin/settings#notify" style="text-decoration:underline;">فعّله من الإعدادات</a>.
                  <% } else { %>راجع مدير النظام.<% } %>
                  يبقى زر واتساب اليدوي أعلاه متاحاً.
                </p>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
        <% } %>

        <!-- Add Note -->
        <div class="bg-white rounded-2xl p-6">
          <h2 class="font-bold text-[#001736] text-sm mb-4 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">add_comment</span>
            إضافة ملاحظة / نشاط
          </h2>
          <div id="noteForm" class="space-y-3">
            <div class="flex gap-3 flex-wrap">
              <% Object.entries(NOTE_TYPES).forEach(([k, v]) => { %>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="radio" name="note_type_select" value="<%= k %>" class="hidden"
                       onchange="selectNoteType('<%= k %>')" <%= k === 'note' ? 'checked' : '' %>>
                <div class="note-type-btn px-3 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer flex items-center gap-1.5
                            <%= k === 'note' ? 'bg-[#001736] text-white border-[#001736]' : 'border-[#e0e3e5] text-[#43474f] hover:bg-[#f2f4f6]' %>"
                     data-type="<%= k %>">
                  <span class="material-symbols-outlined text-sm"><%= v.icon %></span>
                  <%= v.label %>
                </div>
              </label>
              <% }) %>
            </div>
            <textarea id="noteContent" rows="3" placeholder="اكتب ملاحظتك هنا..."
                      class="w-full border border-[#e0e3e5] rounded-xl p-3 text-sm focus:outline-none focus:border-[#7594ca] focus:ring-1 focus:ring-[#7594ca]/30 resize-none transition-all"
                      onkeydown="if(event.ctrlKey && event.key==='Enter') addNote()"></textarea>
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#43474f] hidden sm:block">Ctrl+Enter للإضافة السريعة</span>
              <button onclick="addNote()"
                      class="bg-[#001736] text-white text-sm font-semibold px-5 py-2.5 rounded-xl hover:bg-[#002b5b] transition-colors flex items-center gap-2">
                <span class="material-symbols-outlined text-base">send</span>
                إضافة
              </button>
            </div>
          </div>
        </div>

        <!-- Timeline -->
        <div class="bg-white rounded-2xl p-6">
          <h2 class="font-bold text-[#001736] text-sm mb-5 flex items-center gap-2">
            <span class="material-symbols-outlined text-base">timeline</span>
            السجل والملاحظات
          </h2>

          <div id="timeline" class="space-y-0">
            <%
            const noteTypeColors = {
              note: 'bg-blue-100 text-blue-700',
              call: 'bg-green-100 text-green-700',
              interview: 'bg-purple-100 text-purple-700',
              follow_up: 'bg-orange-100 text-orange-700'
            };
            // Merge notes + activity into one timeline, sorted by date desc
            const timelineItems = [
              ...notes.map(n => ({ ...n, _type: 'note' })),
              ...activity.map(a => ({ ...a, _type: 'activity' }))
            ].sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
            %>

            <% if (timelineItems.length === 0) { %>
            <div class="text-center py-8 text-[#43474f] text-sm">
              <span class="material-symbols-outlined text-3xl block mb-2 text-[#c4c6d0]">chat_bubble_outline</span>
              لا توجد ملاحظات أو سجل نشاط بعد
            </div>
            <% } %>

            <% timelineItems.forEach((item, idx) => { %>
            <div class="flex gap-4 pb-5 <%= idx < timelineItems.length - 1 ? 'border-b border-[#f2f4f6]' : '' %>"
                 id="<%= item._type === 'note' ? 'note-' + item.id : 'activity-' + item.id %>">
              <!-- Icon -->
              <div class="flex-shrink-0 mt-1">
                <% if (item._type === 'note') { %>
                <div class="w-9 h-9 rounded-xl <%= noteTypeColors[item.type] || 'bg-gray-100 text-gray-600' %> flex items-center justify-center">
                  <span class="material-symbols-outlined text-base"><%= NOTE_TYPES[item.type]?.icon || 'edit_note' %></span>
                </div>
                <% } else { %>
                <div class="w-9 h-9 rounded-xl bg-[#f2f4f6] flex items-center justify-center">
                  <span class="material-symbols-outlined text-base text-[#43474f]">history</span>
                </div>
                <% } %>
              </div>
              <!-- Content -->
              <div class="flex-1 min-w-0">
                <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2">
                  <div class="flex-1 min-w-0">
                    <% if (item._type === 'note') { %>
                    <span class="text-xs font-semibold <%= noteTypeColors[item.type] || 'bg-gray-100 text-gray-600' %> px-2 py-0.5 rounded-full">
                      <%= NOTE_TYPES[item.type]?.label || item.type %>
                    </span>
                    <!-- عرض النص الأصلي -->
                    <p class="text-sm text-[#191c1e] mt-2 leading-relaxed note-text" id="note-text-<%= item.id %>"><%= item.content %></p>
                    <!-- حقل التعديل (مخفي افتراضياً) -->
                    <div id="note-edit-<%= item.id %>" class="hidden mt-2">
                      <textarea rows="3"
                        class="w-full border border-[#7594ca] rounded-xl p-2.5 text-sm focus:outline-none focus:ring-1 focus:ring-[#7594ca]/30 resize-none"
                        id="note-edit-input-<%= item.id %>"><%= item.content %></textarea>
                      <div class="flex items-center gap-2 mt-2">
                        <button onclick="saveEdit(<%= item.id %>)"
                                class="bg-[#001736] text-white text-xs font-semibold px-4 py-1.5 rounded-lg hover:bg-[#002b5b] transition-colors flex items-center gap-1">
                          <span class="material-symbols-outlined text-sm">check</span>
                          حفظ
                        </button>
                        <button onclick="cancelEdit(<%= item.id %>)"
                                class="text-[#43474f] text-xs px-3 py-1.5 rounded-lg bg-[#f2f4f6] hover:bg-[#eceef0] transition-colors">
                          إلغاء
                        </button>
                      </div>
                    </div>
                    <% } else { %>
                    <div class="text-sm text-[#43474f]">
                      <span class="font-medium text-[#191c1e]"><%= item.action %></span>
                      <% if (item.old_value && item.new_value) { %>
                      <span class="mx-1">:</span>
                      <span class="line-through text-[#c4c6d0]"><%= item.old_value %></span>
                      <span class="mx-1 material-symbols-outlined text-xs align-middle">arrow_back</span>
                      <span class="font-medium text-[#001736]"><%= item.new_value %></span>
                      <% } else if (item.new_value) { %>
                      <span class="mx-1">—</span><span class="text-[#001736]"><%= item.new_value %></span>
                      <% } %>
                    </div>
                    <% } %>
                  </div>
                  <div class="flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-start gap-2 sm:gap-1 flex-shrink-0">
                    <!-- التاريخ والمستخدم -->
                    <div class="text-right sm:text-left">
                      <% if (item.user_name) { %>
                      <span class="block text-[10px] text-[#7594ca] font-medium whitespace-nowrap">
                        <span class="material-symbols-outlined text-[10px] align-middle" style="font-variation-settings:'FILL' 1">person</span>
                        <%= item.user_name %>
                      </span>
                      <% } %>
                      <span class="text-xs text-[#43474f] whitespace-nowrap">
                        <%= fmtDate(item.created_at) %>
                        <%= fmtTime(item.created_at) %>
                      </span>
                      <% if (item.updated_at) { %>
                      <span class="block text-[10px] text-[#9ca3af] whitespace-nowrap">
                        عُدّل: <%= fmtDate(item.updated_at) %>
                      </span>
                      <% } %>
                    </div>
                    <!-- أزرار العمليات -->
                    <% if (item._type === 'note') { %>
                    <div class="flex items-center gap-1" id="note-actions-<%= item.id %>">
                      <button onclick="startEdit(<%= item.id %>)"
                              class="flex items-center gap-1 text-[10px] font-medium text-[#405f91] bg-[#eef2fa] hover:bg-[#dce6f7] px-2 py-0.5 rounded-lg transition-colors">
                        <span class="material-symbols-outlined text-[11px]">edit</span>
                        تعديل
                      </button>
                      <button onclick="deleteNote(<%= item.id %>)"
                              class="flex items-center gap-1 text-[10px] font-medium text-red-500 bg-red-50 hover:bg-red-100 px-2 py-0.5 rounded-lg transition-colors">
                        <span class="material-symbols-outlined text-[11px]">delete</span>
                        حذف
                      </button>
                    </div>
                    <% } else { %>
                    <button onclick="deleteActivity(<%= item.id %>)"
                            class="flex items-center gap-1 text-[10px] font-medium text-red-400 hover:text-red-600 hover:bg-red-50 px-2 py-0.5 rounded-lg transition-colors">
                      <span class="material-symbols-outlined text-[11px]">delete</span>
                      حذف
                    </button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        </div>

      </div>
    </div>
  </main>
</div>

<!-- ═══════════════════════════════════════════════════════════
     صفحة الطباعة — تظهر فقط عند print
     ═══════════════════════════════════════════════════════════ -->
<div id="print-doc" dir="rtl" lang="ar"
     style="font-family:'Segoe UI',Tahoma,Arial,sans-serif;color:#111;background:#fff;max-width:100%">

  <%
    const printDate   = fmtDateLong(new Date());
    const printTime   = fmtTime(new Date());
    const appliedDate = fmtDateLong(applicant.created_at);
    const genderLabel = applicant.gender === 'male' ? 'ذكر' : applicant.gender === 'female' ? 'أنثى' : '—';
    const statusLabel = STATUS_META[applicant.status]?.label || applicant.status;
    const ratingStars = '★'.repeat(applicant.rating) + '☆'.repeat(5 - applicant.rating);
    const QUAL_PRINT = { none:'بدون مؤهل', primary:'ابتدائي', middle:'متوسط', high_school:'ثانوي', university:'جامعي' };
    // الطباعة: الملاحظات + سجل النظام معاً، مرتّبة من الأقدم للأحدث
    const printTimeline = [
      ...notes.map(n => ({ ...n, _type: 'note' })),
      ...activity.map(a => ({ ...a, _type: 'activity' }))
    ].sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
  %>

  <!-- ── رأس الصفحة ─────────────────────────────────────────── -->
  <div style="border-bottom:3px solid #001736;padding-bottom:14px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between">
    <div style="display:flex;align-items:center;gap:14px">
      <img src="/images/icon.png" alt="أرتال" style="height:52px;width:auto;object-fit:contain">
      <div>
        <div style="font-size:18px;font-weight:800;color:#001736">شركة أرتال للحراسات الأمنية المدنية الخاصة</div>
        <div style="font-size:11px;color:#506169;margin-top:2px;letter-spacing:0.04em">نموذج طلب توظيف — ملف متقدم</div>
      </div>
    </div>
    <div style="text-align:left;font-size:11px;color:#506169;line-height:1.7">
      <div><strong style="color:#001736">رقم الملف:</strong> #<%= applicant.id %></div>
      <div><strong style="color:#001736">طُبع بتاريخ:</strong> <%= printDate %> الساعة <%= printTime %></div>
    </div>
  </div>

  <!-- ── البيانات الشخصية ───────────────────────────────────── -->
  <div class="pd-avoid-break" style="margin-bottom:20px">
    <div style="background:#001736;color:#fff;padding:7px 12px;border-radius:6px;font-size:12px;font-weight:700;margin-bottom:10px">
      البيانات الشخصية
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <tbody>
        <tr style="background:#f8f9fb">
          <td style="padding:8px 12px;font-weight:700;color:#43474f;width:28%;border:1px solid #e0e3e5">الاسم الرباعي</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5;font-weight:600;font-size:14px"><%= applicant.full_name %></td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;width:28%;border:1px solid #e0e3e5">رقم الهوية الوطنية</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5;font-family:monospace;direction:ltr;text-align:right"><%= applicant.id_number %></td>
        </tr>
        <tr>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">رقم الجوال</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5;direction:ltr;text-align:right"><%= applicant.phone %></td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">العمر</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5"><%= applicant.age ? applicant.age + ' سنة' : '—' %></td>
        </tr>
        <tr style="background:#f8f9fb">
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">الجنس</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5"><%= genderLabel %></td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">المنطقة الإدارية</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5"><%= applicant.region || '—' %></td>
        </tr>
        <tr>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">المدينة / المحافظة</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5"><%= applicant.city || '—' %></td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">الحي</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5"><%= applicant.neighborhood || '—' %></td>
        </tr>
        <tr style="background:#f8f9fb">
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">يمتلك سيارة</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5">
            <span style="color:<%= applicant.has_car ? '#15803d' : '#6b7280' %>;font-weight:600">
              <%= applicant.has_car ? '✓ نعم' : '✗ لا' %>
            </span>
          </td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">رخصة قيادة</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5">
            <span style="color:<%= applicant.has_license ? '#15803d' : '#6b7280' %>;font-weight:600">
              <%= applicant.has_license ? '✓ نعم' : '✗ لا' %>
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">إجادة الإنجليزية</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5">
            <% if (applicant.english == null) { %>—<% } else { %>
            <span style="color:<%= applicant.english ? '#15803d' : '#6b7280' %>;font-weight:600">
              <%= applicant.english ? '✓ نعم' : '✗ لا' %>
            </span>
            <% } %>
          </td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">المؤهل العلمي</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5">
            <%= QUAL_PRINT[applicant.qualification] || applicant.qualification || '—' %>
            <% if (applicant.specialization) { %>
            <span style="color:#506169;font-size:11px"> · تخصص: <%= applicant.specialization %></span>
            <% } %>
          </td>
        </tr>
        <tr style="background:#f8f9fb">
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">البريد الإلكتروني</td>
          <td colspan="3" style="padding:8px 12px;border:1px solid #e0e3e5;direction:ltr;text-align:right"><%= applicant.email || '—' %></td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ── حالة الطلب ─────────────────────────────────────────── -->
  <div class="pd-avoid-break" style="margin-bottom:20px">
    <div style="background:#001736;color:#fff;padding:7px 12px;border-radius:6px;font-size:12px;font-weight:700;margin-bottom:10px">
      حالة الطلب
    </div>
    <table style="width:100%;border-collapse:collapse;font-size:13px">
      <tbody>
        <tr style="background:#f8f9fb">
          <td style="padding:8px 12px;font-weight:700;color:#43474f;width:28%;border:1px solid #e0e3e5">تاريخ التقديم</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5"><%= appliedDate %></td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;width:28%;border:1px solid #e0e3e5">الحالة الحالية</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5;font-weight:700"><%= statusLabel %></td>
        </tr>
        <tr>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">التقييم</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5;font-size:16px;letter-spacing:2px"><%= ratingStars %> (<%= applicant.rating %>/5)</td>
          <td style="padding:8px 12px;font-weight:700;color:#43474f;border:1px solid #e0e3e5">المرفقات</td>
          <td style="padding:8px 12px;border:1px solid #e0e3e5">
            <span style="color:<%= applicant.cv_path ? '#15803d' : '#6b7280' %>"><%= applicant.cv_path ? '✓' : '✗' %> السيرة الذاتية</span>
            &nbsp;&nbsp;
            <span style="color:<%= applicant.id_image_path ? '#15803d' : '#6b7280' %>"><%= applicant.id_image_path ? '✓' : '✗' %> صورة الهوية</span>
          </td>
        </tr>
      </tbody>
    </table>
  </div>

  <!-- ── السجل والملاحظات ───────────────────────────────────── -->
  <div style="margin-bottom:20px">
    <div style="background:#001736;color:#fff;padding:7px 12px;border-radius:6px;font-size:12px;font-weight:700;margin-bottom:10px">
      السجل الكامل والملاحظات
      <span style="font-weight:400;font-size:11px;opacity:0.7;margin-right:8px">(<%= printTimeline.length %> إدخال، مرتّب من الأقدم للأحدث)</span>
    </div>

    <% if (printTimeline.length === 0) { %>
    <div style="text-align:center;padding:20px;color:#6b7280;font-size:13px;border:1px dashed #e0e3e5;border-radius:6px">
      لا يوجد سجل أو ملاحظات بعد
    </div>
    <% } else { %>
    <table style="width:100%;border-collapse:collapse;font-size:12px">
      <thead>
        <tr style="background:#f2f4f6">
          <th style="padding:8px 10px;text-align:right;font-weight:700;color:#43474f;border:1px solid #e0e3e5;width:13%">التاريخ والوقت</th>
          <th style="padding:8px 10px;text-align:right;font-weight:700;color:#43474f;border:1px solid #e0e3e5;width:12%">النوع</th>
          <th style="padding:8px 10px;text-align:right;font-weight:700;color:#43474f;border:1px solid #e0e3e5;width:14%">بواسطة</th>
          <th style="padding:8px 10px;text-align:right;font-weight:700;color:#43474f;border:1px solid #e0e3e5">التفاصيل</th>
        </tr>
      </thead>
      <tbody>
        <% printTimeline.forEach((item, idx) => { %>
        <tr class="pd-avoid-break" style="background:<%= idx % 2 === 0 ? '#fff' : '#fafbfc' %>">
          <td style="padding:8px 10px;border:1px solid #e0e3e5;color:#506169;white-space:nowrap;font-size:11px">
            <%= fmtDate(item.created_at) %><br>
            <span style="color:#7594ca"><%= fmtTime(item.created_at) %></span>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e3e5;text-align:center">
            <% if (item._type === 'note') { %>
            <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;
              background:<%= item.type==='call'?'#dcfce7':item.type==='interview'?'#ede9fe':item.type==='follow_up'?'#ffedd5':'#dbeafe' %>;
              color:<%= item.type==='call'?'#15803d':item.type==='interview'?'#7c3aed':item.type==='follow_up'?'#c2410c':'#1d4ed8' %>">
              <%= NOTE_TYPES[item.type]?.label || item.type %>
            </span>
            <% } else { %>
            <span style="font-size:10px;font-weight:700;padding:2px 7px;border-radius:20px;background:#f2f4f6;color:#43474f">
              سجل النظام
            </span>
            <% } %>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e3e5;color:#506169;font-size:11px">
            <%= item.user_name || '—' %>
          </td>
          <td style="padding:8px 10px;border:1px solid #e0e3e5;line-height:1.6">
            <% if (item._type === 'note') { %>
              <%= item.content %>
            <% } else { %>
              <strong><%= item.action %></strong>
              <% if (item.old_value && item.new_value) { %>
                &nbsp;— من <span style="text-decoration:line-through;color:#9ca3af"><%= item.old_value %></span>
                إلى <strong style="color:#001736"><%= item.new_value %></strong>
              <% } else if (item.new_value) { %>
                &nbsp;— <span style="color:#001736"><%= item.new_value %></span>
              <% } %>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>
  </div>

  <!-- ── تذييل الصفحة ──────────────────────────────────────── -->
  <div style="border-top:2px solid #e0e3e5;margin-top:24px;padding-top:12px;display:flex;justify-content:flex-end;align-items:center;font-size:10px;color:#9ca3af">
    <div style="text-align:left">
      طُبع بواسطة: <strong><%= locals.adminName || adminUser %></strong>
      &nbsp;·&nbsp; بتاريخ <%= printDate %> &nbsp;·&nbsp; ملف رقم #<%= applicant.id %>
    </div>
  </div>

</div>
<!-- ═══════════════════════════════════════════════════════════ -->

<!-- Toast notification -->
<div id="toast" class="fixed bottom-6 left-6 bg-[#001736] text-white text-sm px-5 py-3 rounded-xl shadow-2xl
     transform translate-y-16 opacity-0 transition-all duration-300 z-50 flex items-center gap-2">
  <span class="material-symbols-outlined text-[#ffdf9e] text-base" id="toastIcon">check</span>
  <span id="toastMsg"></span>
</div>

<!-- ═══ نافذة جدولة المقابلة ═══
     <dialog> يُرسم في الـ top layer — لا يتأثر بأي overflow أو z-index.
     التنسيق سطري عمداً: لا أصناف Tailwind جديدة ⇒ لا حاجة لإعادة بناء CSS. -->
<% if (typeof interviewsEnabled !== 'undefined' && interviewsEnabled) { %>
<dialog id="iv-modal" style="border:none;border-radius:1rem;padding:0;max-width:640px;width:92vw;box-shadow:0 20px 60px rgba(0,0,0,.25);">
  <div style="padding:1.5rem;font-family:'Inter',sans-serif;" dir="rtl">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;">
      <h3 style="font-family:'Manrope',sans-serif;font-weight:700;color:#001736;font-size:1rem;margin:0;" id="iv-modal-title">جدولة مقابلة أونلاين</h3>
      <button type="button" onclick="closeInterviewModal()" style="background:none;border:none;cursor:pointer;color:#43474f;font-size:1.25rem;line-height:1;">&times;</button>
    </div>

    <div id="iv-alert" style="display:none;border-radius:.75rem;padding:.65rem .9rem;font-size:.75rem;margin-bottom:.9rem;"></div>

    <div style="margin-bottom:1rem;">
      <div style="font-size:.7rem;font-weight:700;color:#43474f;letter-spacing:.04em;margin-bottom:.5rem;">المقابلون</div>
      <div id="iv-people" style="display:flex;flex-wrap:wrap;gap:.4rem;"></div>
    </div>

    <div style="margin-bottom:.75rem;">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem;">
        <div style="font-size:.7rem;font-weight:700;color:#43474f;letter-spacing:.04em;">اليوم</div>
        <button type="button" onclick="loadAvailability()" id="iv-reload"
                style="font-size:.7rem;font-weight:600;color:#405f91;background:none;border:none;cursor:pointer;">تحديث الأوقات</button>
      </div>
      <div id="iv-days" style="display:flex;gap:.4rem;overflow-x:auto;padding-bottom:.35rem;"></div>
    </div>

    <div id="iv-slots" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(84px,1fr));gap:.5rem;min-height:110px;max-height:220px;overflow-y:auto;padding:.25rem;background:#f8f9fb;border-radius:.75rem;"></div>

    <div style="margin-top:1rem;">
      <div style="font-size:.7rem;font-weight:700;color:#43474f;letter-spacing:.04em;margin-bottom:.4rem;">الوظيفة</div>
      <input type="text" id="iv-job" maxlength="100" placeholder="حارس أمن"
             style="width:100%;border:1px solid #e0e3e5;border-radius:.75rem;padding:.6rem .8rem;font-size:.8rem;outline:none;font-family:'Inter',sans-serif;">
      <div style="font-size:.65rem;color:#7594ca;margin-top:.3rem;">تظهر في رسالة الواتساب والبريد ووصف الاجتماع — مُستنتجة من صفحة الوظيفة التي قدّم منها، عدّلها إن لزم.</div>
    </div>

    <div style="margin-top:1rem;">
      <div style="font-size:.7rem;font-weight:700;color:#43474f;letter-spacing:.04em;margin-bottom:.4rem;">ملاحظة (اختياري)</div>
      <textarea id="iv-note" rows="2" placeholder="تُضاف إلى وصف الاجتماع وملف المتقدم"
                style="width:100%;border:1px solid #e0e3e5;border-radius:.75rem;padding:.6rem .8rem;font-size:.8rem;resize:none;outline:none;font-family:'Inter',sans-serif;"></textarea>
    </div>

    <div style="display:flex;gap:.6rem;margin-top:1.1rem;">
      <button type="button" id="iv-confirm" onclick="confirmInterview()" disabled
              style="flex:1;background:#001736;color:#fff;font-weight:700;padding:.8rem;border:none;border-radius:.75rem;cursor:pointer;font-size:.85rem;opacity:.5;">
        تأكيد الموعد
      </button>
      <button type="button" onclick="closeInterviewModal()"
              style="padding:.8rem 1.2rem;background:#fff;color:#43474f;font-weight:600;border:1px solid #e0e3e5;border-radius:.75rem;cursor:pointer;font-size:.85rem;">
        إلغاء
      </button>
    </div>
  </div>
</dialog>
<% } %>

<% const WTM = (typeof waTemplates !== 'undefined' && waTemplates) ? waTemplates : { list: [], fields: {}, defaults: {} }; %>
<% if (WTM.list.length && applicant.phone) { %>
<dialog id="wt-modal" style="border:none;border-radius:1rem;padding:0;max-width:460px;width:92vw;box-shadow:0 20px 60px rgba(0,0,0,.25);">
  <div style="padding:1.5rem;font-family:'Inter',sans-serif;" dir="rtl">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.4rem;">
      <h3 id="wt-title" style="font-family:'Manrope',sans-serif;font-weight:700;color:#001736;font-size:1rem;margin:0;"></h3>
      <button type="button" onclick="closeWaTemplate()" style="background:none;border:none;cursor:pointer;color:#43474f;font-size:1.25rem;line-height:1;">&times;</button>
    </div>
    <p id="wt-desc" style="font-size:.72rem;color:#43474f;margin:0 0 1rem;line-height:1.8;"></p>

    <div id="wt-alert" style="display:none;border-radius:.75rem;padding:.65rem .9rem;font-size:.75rem;margin-bottom:.9rem;"></div>

    <!-- كل الحقول تُعرض ويُخفى ما لا يخصّ القالب المختار -->
    <% Object.entries(WTM.fields).forEach(function (e) { const f = e[0], meta = e[1]; %>
    <div class="wt-field" data-field="<%= f %>" style="display:none;margin-bottom:.85rem;">
      <div style="font-size:.7rem;font-weight:700;color:#43474f;margin-bottom:.35rem;"><%= meta.label %></div>
      <input type="text" id="wt-f-<%= f %>" maxlength="<%= meta.max %>" placeholder="<%= meta.placeholder %>"
             style="width:100%;border:1px solid #e0e3e5;border-radius:.75rem;padding:.6rem .8rem;font-size:.8rem;outline:none;font-family:'Inter',sans-serif;">
    </div>
    <% }); %>

    <p style="font-size:.65rem;color:#7594ca;margin:.5rem 0 0;">تظهر هذه الحقول داخل نص الرسالة — لا يقبل واتساب أي حقل فارغ.</p>

    <div style="display:flex;gap:.6rem;margin-top:1.2rem;">
      <button type="button" id="wt-send" onclick="sendWaTemplate()"
              style="flex:1;background:#001736;color:#fff;font-weight:700;padding:.8rem;border:none;border-radius:.75rem;cursor:pointer;font-size:.85rem;">
        إرسال عبر واتساب
      </button>
      <button type="button" onclick="closeWaTemplate()"
              style="padding:.8rem 1.2rem;background:#fff;color:#43474f;font-weight:600;border:1px solid #e0e3e5;border-radius:.75rem;cursor:pointer;font-size:.85rem;">
        إلغاء
      </button>
    </div>
  </div>
</dialog>
<% } %>

<script>
const APPLICANT_ID = <%= applicant.id %>;
const WT_LIST     = <%- JSON.stringify(typeof waTemplates !== 'undefined' ? waTemplates.list : []) %>;
const WT_DEFAULTS = <%- JSON.stringify(typeof waTemplates !== 'undefined' ? waTemplates.defaults : {}) %>;
let selectedNoteType = 'note';

// ─── بيانات المقابلة (تُحقن من الخادم) ─────────────────────────────────────
const IV_ENABLED     = <%- JSON.stringify(typeof interviewsEnabled !== 'undefined' ? Boolean(interviewsEnabled) : false) %>;
const IV_ACTIVE      = <%- JSON.stringify(typeof activeInterview !== 'undefined' ? activeInterview : null) %>;
const IV_PEOPLE      = <%- JSON.stringify(typeof interviewerList !== 'undefined' ? interviewerList : []) %>;
const IV_CURRENT_USR = <%- JSON.stringify(adminUser || '') %>;
const IV_JOB_GUESS   = <%- JSON.stringify(typeof jobTitleGuess !== 'undefined' ? jobTitleGuess : '') %>;

function toast(msg, icon = 'check', isError = false) {
  const el = document.getElementById('toast');
  const ic = document.getElementById('toastIcon');
  document.getElementById('toastMsg').textContent = msg;
  ic.textContent = icon;
  el.classList.toggle('bg-red-800', isError);
  el.classList.toggle('bg-[#001736]', !isError);
  el.classList.remove('translate-y-16', 'opacity-0');
  setTimeout(() => el.classList.add('translate-y-16', 'opacity-0'), 2500);
}

function selectNoteType(type) {
  selectedNoteType = type;
  document.querySelectorAll('.note-type-btn').forEach(btn => {
    const active = btn.dataset.type === type;
    btn.className = btn.className.replace(/(bg-\[#001736\] text-white border-\[#001736\]|border-\[#e0e3e5\] text-\[#43474f\] hover:bg-\[#f2f4f6\])/g, '');
    btn.classList.add(...(active
      ? ['bg-[#001736]', 'text-white', 'border-[#001736]']
      : ['border-[#e0e3e5]', 'text-[#43474f]', 'hover:bg-[#f2f4f6]']));
  });
}

function setRating(val) {
  fetch(`/admin/applicants/${APPLICANT_ID}/rating`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ rating: val })
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      document.querySelectorAll('.star-btn').forEach((btn, i) => {
        btn.classList.toggle('active', i < data.rating);
      });
      toast('تم تحديث التقييم', 'star');
    }
  });
}

function updateStatus(status) {
  fetch(`/admin/applicants/${APPLICANT_ID}/status`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status })
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      toast('تم تحديث الحالة إلى: ' + data.label, 'check_circle');
      setTimeout(() => location.reload(), 800);
    }
  });
}

function addNote() {
  const content = document.getElementById('noteContent').value.trim();
  if (!content) { toast('يرجى كتابة ملاحظة', 'warning', true); return; }

  fetch(`/admin/applicants/${APPLICANT_ID}/notes`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ content, type: selectedNoteType })
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      document.getElementById('noteContent').value = '';
      toast('تمت إضافة الملاحظة', 'check_circle');
      setTimeout(() => location.reload(), 600);
    }
  });
}

// ═══════════════════════════════════════════════════════════════════════════
//  المقابلة الأونلاين
// ═══════════════════════════════════════════════════════════════════════════
let ivSelectedPeople = new Set();
let ivDays = [];
let ivActiveDate = null;
let ivSelectedSlot = null;
let ivRescheduleMode = false;
let ivLoadTimer = null;

function ivAlert(msg, kind = 'error') {
  const el = document.getElementById('iv-alert');
  if (!el) return;
  if (!msg) { el.style.display = 'none'; return; }
  const c = kind === 'warn' ? ['#fffbeb', '#fde68a', '#92400e'] : ['#fef2f2', '#fecaca', '#b91c1c'];
  el.style.display = 'block';
  el.style.background = c[0]; el.style.border = `1px solid ${c[1]}`; el.style.color = c[2];
  el.textContent = msg;
}

function renderPeople() {
  const wrap = document.getElementById('iv-people');
  if (!wrap) return;
  wrap.innerHTML = '';
  IV_PEOPLE.forEach(p => {
    const on = ivSelectedPeople.has(p.username);
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = p.full_name || p.username;
    b.title = p.username;
    b.style.cssText = `border-radius:9999px;padding:.35rem .8rem;font-size:.75rem;font-weight:600;cursor:pointer;
      border:1px solid ${on ? '#001736' : '#e0e3e5'};background:${on ? '#001736' : '#fff'};color:${on ? '#fff' : '#43474f'};`;
    b.onclick = () => {
      if (ivSelectedPeople.has(p.username)) ivSelectedPeople.delete(p.username);
      else ivSelectedPeople.add(p.username);
      renderPeople();
      clearTimeout(ivLoadTimer);
      ivLoadTimer = setTimeout(loadAvailability, 400);   // إعادة الجلب عند تغيير الاختيار
    };
    wrap.appendChild(b);
  });
}

function renderDays() {
  const wrap = document.getElementById('iv-days');
  wrap.innerHTML = '';
  ivDays.forEach(d => {
    const active = d.date === ivActiveDate;
    const empty = d.slots.length === 0;
    const b = document.createElement('button');
    b.type = 'button';
    b.disabled = empty;
    b.innerHTML = `${d.labelShort} <span style="opacity:.7">(${d.slots.length})</span>`;
    b.style.cssText = `white-space:nowrap;border-radius:.6rem;padding:.4rem .7rem;font-size:.72rem;font-weight:600;
      cursor:${empty ? 'not-allowed' : 'pointer'};opacity:${empty ? '.45' : '1'};
      border:1px solid ${active ? '#001736' : '#e0e3e5'};background:${active ? '#001736' : '#fff'};color:${active ? '#fff' : '#43474f'};`;
    b.onclick = () => { ivActiveDate = d.date; ivSelectedSlot = null; renderDays(); renderSlots(); updateConfirm(); };
    wrap.appendChild(b);
  });
}

function renderSlots() {
  const wrap = document.getElementById('iv-slots');
  wrap.innerHTML = '';
  const day = ivDays.find(d => d.date === ivActiveDate);
  if (!day || !day.slots.length) {
    wrap.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:#7594ca;font-size:.75rem;padding:2rem 0;">لا توجد أوقات متاحة في هذا اليوم</div>';
    return;
  }
  day.slots.forEach(s => {
    const on = ivSelectedSlot === s.key;
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = s.time;
    b.dir = 'ltr';
    b.style.cssText = `padding:.5rem;border-radius:.6rem;font-size:.78rem;font-weight:600;cursor:pointer;
      border:1px solid ${on ? '#001736' : '#e0e3e5'};background:${on ? '#001736' : '#fff'};color:${on ? '#fff' : '#001736'};`;
    b.onclick = () => { ivSelectedSlot = s.key; renderSlots(); updateConfirm(); };
    wrap.appendChild(b);
  });
}

function updateConfirm() {
  const btn = document.getElementById('iv-confirm');
  const ready = Boolean(ivSelectedSlot) && ivSelectedPeople.size > 0;
  btn.disabled = !ready;
  btn.style.opacity = ready ? '1' : '.5';
  btn.style.cursor = ready ? 'pointer' : 'not-allowed';
}

function loadAvailability() {
  const slots = document.getElementById('iv-slots');
  const reload = document.getElementById('iv-reload');
  slots.innerHTML = '<div style="grid-column:1/-1;text-align:center;color:#7594ca;font-size:.75rem;padding:2rem 0;">جارٍ جلب الأوقات…</div>';
  document.getElementById('iv-days').innerHTML = '';
  if (reload) reload.disabled = true;
  ivAlert('');

  const q = encodeURIComponent([...ivSelectedPeople].join(','));
  fetch(`/admin/interviews/availability?interviewers=${q}`)
    .then(async r => ({ status: r.status, data: await r.json().catch(() => ({})) }))
    .then(({ status, data }) => {
      if (status !== 200) {
        slots.innerHTML = '';
        ivAlert(data.error || 'تعذّر جلب الأوقات');
        return;
      }
      ivDays = data.days || [];
      const firstFree = ivDays.find(d => d.slots.length);
      ivActiveDate = firstFree ? firstFree.date : (ivDays[0] && ivDays[0].date) || null;
      ivSelectedSlot = null;
      renderDays(); renderSlots(); updateConfirm();
      if (data.warnings && data.warnings.length) ivAlert(data.warnings.join(' — '), 'warn');
    })
    .catch(() => { slots.innerHTML = ''; ivAlert('تعذّر الاتصال بالخادم'); })
    .finally(() => { if (reload) reload.disabled = false; });
}

function openInterviewModal(reschedule = false) {
  ivRescheduleMode = Boolean(reschedule);
  document.getElementById('iv-modal-title').textContent = ivRescheduleMode ? 'إعادة جدولة المقابلة' : 'جدولة مقابلة أونلاين';
  document.getElementById('iv-confirm').textContent = ivRescheduleMode ? 'تأكيد الموعد الجديد' : 'تأكيد الموعد';

  ivSelectedPeople = new Set();
  if (ivRescheduleMode && IV_ACTIVE) IV_ACTIVE.interviewers.forEach(p => ivSelectedPeople.add(p.email));

  const jobEl = document.getElementById('iv-job');
  if (jobEl) jobEl.value = (IV_ACTIVE && IV_ACTIVE.jobTitle) || IV_JOB_GUESS || '';
  else if (IV_PEOPLE.some(p => p.username === IV_CURRENT_USR)) ivSelectedPeople.add(IV_CURRENT_USR);

  renderPeople();
  updateConfirm();

  const modal = document.getElementById('iv-modal');
  if (modal.showModal) modal.showModal(); else modal.setAttribute('open', '');
  loadAvailability();
}

function closeInterviewModal() {
  const modal = document.getElementById('iv-modal');
  if (modal.close) modal.close(); else modal.removeAttribute('open');
}

function confirmInterview() {
  const btn = document.getElementById('iv-confirm');
  if (btn.disabled) return;
  btn.disabled = true;
  btn.textContent = 'جارٍ الحفظ…';
  ivAlert('');

  const url    = ivRescheduleMode ? `/admin/interviews/${IV_ACTIVE.id}` : `/admin/applicants/${APPLICANT_ID}/interview`;
  const method = ivRescheduleMode ? 'PATCH' : 'POST';
  const body   = {
    slotKey: ivSelectedSlot,
    interviewers: [...ivSelectedPeople],
    jobTitle: (document.getElementById('iv-job').value || '').trim(),
    note: document.getElementById('iv-note').value.trim(),
  };

  fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) })
    .then(async r => ({ status: r.status, data: await r.json().catch(() => ({})) }))
    .then(({ status, data }) => {
      if (status === 200 && data.ok) {
        const base = ivRescheduleMode ? 'تم تعديل الموعد' : 'تمت جدولة المقابلة';
        const bad  = failedChannels(data.delivery);
        // الموعد نجح حتى لو تعثّر الإشعار — نقول ذلك صراحةً بدل رسالة نجاح تخفي الفشل
        if (bad.length) toast(`${base} — لكن تعذّر إشعار المتقدم عبر ${bad.join(' و')}`, 'warning', true);
        else toast(base, 'event_available');
        setTimeout(() => location.reload(), bad.length ? 2600 : 800);
        return;
      }
      btn.disabled = false;
      btn.textContent = ivRescheduleMode ? 'تأكيد الموعد الجديد' : 'تأكيد الموعد';
      if (data.code === 'SLOT_TAKEN') {
        ivAlert(data.error || 'حُجز هذا الموعد للتو');
        loadAvailability();
        return;
      }
      if (data.code === 'GOOGLE_DISCONNECTED' || data.code === 'IV_OFF') {
        closeInterviewModal();
        toast(data.error || 'ميزة المقابلات غير متاحة', 'error', true);
        return;
      }
      ivAlert(data.error || 'تعذّر حفظ الموعد');
    })
    .catch(() => {
      btn.disabled = false;
      btn.textContent = ivRescheduleMode ? 'تأكيد الموعد الجديد' : 'تأكيد الموعد';
      ivAlert('تعذّر الاتصال بالخادم');
    });
}

// ─── قوالب واتساب اليدوية ───────────────────────────────────────────────────
let wtCurrent = null;

function wtAlert(msg) {
  const el = document.getElementById('wt-alert');
  if (!el) return;
  el.textContent = msg;
  el.style.display = msg ? 'block' : 'none';
  el.style.background = '#fef2f2'; el.style.color = '#b91c1c';
}

function openWaTemplate(key) {
  const t = WT_LIST.find(x => x.key === key);
  const m = document.getElementById('wt-modal');
  if (!t || !m) return;
  wtCurrent = t;

  document.getElementById('wt-title').textContent = t.title;
  document.getElementById('wt-desc').textContent  = t.desc;
  wtAlert('');

  // يُعرض من الحقول ما يخصّ هذا القالب فقط، مُعبَّأً مسبقاً وقابلاً للتعديل
  document.querySelectorAll('.wt-field').forEach(el => {
    const f = el.dataset.field;
    const on = t.fields.indexOf(f) !== -1;
    el.style.display = on ? 'block' : 'none';
    if (on) {
      const input = document.getElementById('wt-f-' + f);
      const fallback = (f === 'job' && IV_ACTIVE && IV_ACTIVE.jobTitle) ? IV_ACTIVE.jobTitle : '';
      input.value = fallback || WT_DEFAULTS[f] || '';
    }
  });

  m.showModal();
  const first = t.fields[0] && document.getElementById('wt-f-' + t.fields[0]);
  if (first) first.focus();
}

function closeWaTemplate() {
  const m = document.getElementById('wt-modal');
  if (m) m.close();
}

function sendWaTemplate() {
  if (!wtCurrent) return;
  const body = { template: wtCurrent.key };
  for (const f of wtCurrent.fields) {
    const v = (document.getElementById('wt-f-' + f).value || '').trim();
    // واتساب يرفض المتغيّر الفارغ — نمنعه هنا برسالة مفهومة بدل خطأ Meta الغامض
    if (!v) { wtAlert('جميع الحقول مطلوبة'); return; }
    body[f] = v;
  }

  const btn = document.getElementById('wt-send');
  btn.disabled = true; btn.style.opacity = '.6'; btn.textContent = 'جارٍ الإرسال…';
  wtAlert('');

  const restore = () => { btn.disabled = false; btn.style.opacity = '1'; btn.textContent = 'إرسال عبر واتساب'; };

  fetch(`/admin/applicants/${APPLICANT_ID}/wa-template`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body),
  })
    .then(async r => ({ status: r.status, data: await r.json().catch(() => ({})) }))
    .then(({ status, data }) => {
      if (status === 200 && data.ok) {
        closeWaTemplate();
        toast('أُرسلت الرسالة عبر واتساب', 'send');
        setTimeout(() => location.reload(), 1200);
        return;
      }
      wtAlert(data.error || 'تعذّر الإرسال');
      restore();
    })
    .catch(() => { wtAlert('تعذّر الاتصال بالخادم'); restore(); });
}

const CH_LABEL = { whatsapp: 'واتساب', email: 'البريد' };

// القنوات التي حاولت الإرسال وفشلت. الحالة skipped ليست فشلاً — تعني أن القناة
// مُطفأة أو لا وجهة لها، وذلك معروض أصلاً كشارة رمادية في البطاقة.
function failedChannels(delivery) {
  return Object.entries(delivery || {})
    .filter(([, r]) => r && r.status === 'failed')
    .map(([ch]) => CH_LABEL[ch] || ch);
}

function resendNotify() {
  if (!IV_ACTIVE) return;
  if (!confirm('إعادة إرسال إشعار الموعد للمتقدم عبر واتساب والبريد؟')) return;

  const btn = document.getElementById('iv-resend');
  if (btn) { btn.disabled = true; btn.style.opacity = '.6'; }

  fetch(`/admin/interviews/${IV_ACTIVE.id}/notify`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({})
  })
    .then(async r => ({ status: r.status, data: await r.json().catch(() => ({})) }))
    .then(({ status, data }) => {
      if (status !== 200 || !data.ok) {
        toast(data.error || 'تعذّر إعادة الإرسال', 'error', true);
        if (btn) { btn.disabled = false; btn.style.opacity = '1'; }
        return;
      }
      const sent = Object.entries(data.delivery || {}).filter(([, r]) => r.status === 'sent').map(([ch]) => CH_LABEL[ch] || ch);
      const bad  = failedChannels(data.delivery);
      if (sent.length) toast(`أُرسل عبر ${sent.join(' و')}`, 'send');
      else toast(bad.length ? `فشل الإرسال عبر ${bad.join(' و')}` : 'لم تُرسل أي قناة — راجع الإعدادات', 'error', true);
      setTimeout(() => location.reload(), 1600);
    })
    .catch(() => {
      toast('تعذّر الاتصال بالخادم', 'error', true);
      if (btn) { btn.disabled = false; btn.style.opacity = '1'; }
    });
}

function copyMeetLink() {
  const el = document.getElementById('meet-link-text');
  if (!el) return;
  navigator.clipboard.writeText(el.textContent.trim())
    .then(() => toast('تم نسخ الرابط', 'content_copy'))
    .catch(() => toast('تعذّر النسخ', 'error', true));
}

function refreshMeetLink() {
  if (!IV_ACTIVE) return;
  fetch(`/admin/interviews/${IV_ACTIVE.id}/refresh-link`, { method: 'POST' })
    .then(r => r.json())
    .then(d => {
      if (d.ok) { toast('تم جلب الرابط', 'check_circle'); setTimeout(() => location.reload(), 600); }
      else toast(d.error || 'الرابط لم يجهز بعد', 'schedule', true);
    })
    .catch(() => toast('تعذّر الاتصال', 'error', true));
}

function cancelInterview() {
  if (!IV_ACTIVE) return;
  if (!confirm('إلغاء هذه المقابلة؟ سيُحذف الاجتماع من التقويم ويصل إشعار للمقابلين.')) return;
  const reason = prompt('سبب الإلغاء (اختياري):') || '';

  fetch(`/admin/interviews/${IV_ACTIVE.id}/cancel`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason })
  })
    .then(async r => ({ status: r.status, data: await r.json().catch(() => ({})) }))
    .then(({ status, data }) => {
      if (status === 200 && data.ok) {
        toast('تم إلغاء المقابلة', 'event_busy');
        setTimeout(() => location.reload(), 700);
        return;
      }
      if (data.canForce && confirm(`${data.error}\n\nهل تريد الإلغاء في النظام فقط (دون التقويم)؟`)) {
        fetch(`/admin/interviews/${IV_ACTIVE.id}/cancel`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ reason, force: true })
        }).then(r => r.json()).then(() => location.reload());
        return;
      }
      toast(data.error || 'تعذّر الإلغاء', 'error', true);
    })
    .catch(() => toast('تعذّر الاتصال بالخادم', 'error', true));
}

// منع Esc أثناء الحفظ (نفس نمط صفحة المتقدمين)
document.addEventListener('DOMContentLoaded', () => {
  const modal = document.getElementById('iv-modal');
  if (!modal) return;
  modal.addEventListener('cancel', (e) => {
    const btn = document.getElementById('iv-confirm');
    if (btn && btn.disabled && btn.textContent.indexOf('جارٍ') !== -1) e.preventDefault();
  });
});

function deleteNote(nid) {
  if (!confirm('هل تريد حذف هذه الملاحظة؟')) return;
  fetch(`/admin/applicants/${APPLICANT_ID}/notes/${nid}`, { method: 'DELETE' })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      const el = document.getElementById('note-' + nid);
      if (el) el.remove();
      toast('تم حذف الملاحظة', 'delete');
    }
  });
}

function deleteActivity(aid) {
  if (!confirm('هل تريد حذف هذا الإدخال من السجل؟')) return;
  fetch(`/admin/applicants/${APPLICANT_ID}/activity/${aid}`, { method: 'DELETE' })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      const el = document.getElementById('activity-' + aid);
      if (el) el.remove();
      toast('تم حذف الإدخال', 'delete');
    } else {
      toast(data.error || 'خطأ في الحذف', 'error', true);
    }
  });
}

function deleteApplicant() {
  if (!confirm('هل أنت متأكد من حذف هذا المتقدم؟ لا يمكن التراجع عن هذا الإجراء.')) return;
  fetch(`/admin/applicants/${APPLICANT_ID}`, { method: 'DELETE' })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      toast('تم حذف المتقدم', 'delete');
      setTimeout(() => location.href = '/admin/applicants', 800);
    }
  });
}

// ─── Helper: تحويل النص لـ HTML آمن (يمنع XSS في innerHTML) ─────────────────
function safeText(val) {
  if (val == null || val === '') return '—';
  const el = document.createElement('span');
  el.textContent = String(val);
  return el.innerHTML;
}

