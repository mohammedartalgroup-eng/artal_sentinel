    .catch(() => {
      const t = document.getElementById('ext-pending-text');
      if (t) t.textContent = 'تعذر التحقق — سيُعاد تلقائياً';
      setTimeout(pollExtCheck, 15000); // أعد المحاولة بعد 15 ثانية
    });
}, 1500);
<% } %>

function extRecheck() {
  toast('جاري إعادة الفحص...', 'autorenew');
  fetch(`/admin/applicants/${APPLICANT_ID}/ext-check`, { method: 'POST' })
    .then(r => r.json())
    .then(data => {
      if (data.ok) {
        if (data.ext_found) {
          toast('✅ تم العثور عليه في النظام السابق', 'check_circle');
        } else {
          toast('لم يُعثر عليه في النظام السابق', 'info');
        }
        setTimeout(() => location.reload(), 1000);
      } else {
        toast('تعذر الاتصال بالنظام الخارجي — تحقق من الاتصال', 'error', true);
      }
    })
    .catch(() => toast('تعذر الاتصال بالخادم', 'error', true));
}

// ─── تعديل الملاحظة ───────────────────────────────────────────────────────────
function startEdit(nid) {
  document.getElementById('note-text-'    + nid).classList.add('hidden');
  document.getElementById('note-edit-'    + nid).classList.remove('hidden');
  document.getElementById('note-actions-' + nid).classList.add('hidden');
  const ta = document.getElementById('note-edit-input-' + nid);
  ta.focus();
  ta.setSelectionRange(ta.value.length, ta.value.length);
}

function cancelEdit(nid) {
  document.getElementById('note-text-'    + nid).classList.remove('hidden');
  document.getElementById('note-edit-'    + nid).classList.add('hidden');
  document.getElementById('note-actions-' + nid).classList.remove('hidden');
}

function saveEdit(nid) {
  const content = document.getElementById('note-edit-input-' + nid).value.trim();
  if (!content) { toast('لا يمكن حفظ ملاحظة فارغة', 'warning', true); return; }

  fetch(`/admin/applicants/${APPLICANT_ID}/notes/${nid}`, {
    method: 'PATCH',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ content })
  })
  .then(r => r.json())
  .then(data => {
    if (data.ok) {
      // حدّث النص في الصفحة بدون ريلود
      const textEl = document.getElementById('note-text-' + nid);
      textEl.textContent = data.content;
      cancelEdit(nid);
      toast('تم حفظ التعديل', 'check_circle');
    } else {
      toast(data.error || 'خطأ في الحفظ', 'error', true);
    }
  })
  .catch(() => toast('خطأ في الاتصال بالخادم', 'error', true));
}
</script>
</body>
</html>
